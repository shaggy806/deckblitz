{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Incremental: a build after a small edit re-checks and re-emits only
       what the edit can affect. The state lives inside dist/, so deleting
       dist deletes it too (tsc never checks that its outputs still exist);
       scripts/dist-complete.mjs drops it when an output has gone missing,
       and scripts/bundle-shards.mjs re-bundles from tsc's raw emit. */
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/test/**"]
}
