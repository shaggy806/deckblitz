{
  // The engine's tests, type-checked: vitest runs them without checking
  // types, so a wrong callback signature or a stale cast lets a test pass
  // without testing. Everything the build compiles plus every test file;
  // nothing is emitted. `npm run typecheck` runs it after the build check.
  // Incremental, its state in the gitignored `.cache/`: a run after a small
  // edit re-checks only what the edit can affect (~3 s warm against ~15 s
  // cold, 2026-10-31); CI starts cold.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsconfig.tests.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
