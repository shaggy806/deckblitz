    {
      "name": "Plunge into Darkness",
      "needs": [
        "effect:pay-any-amount-of-life"
      ],
      "why": "Mode two pays a chosen amount of life as it resolves, then looks at that many cards; no effect takes a player-chosen life payment."
    },
    {
      "name": "Summoner's Egg",
      "needs": [
        "effect:exile-from-hand-face-down-linked",
        "effect:linked-face-down-exile-to-battlefield"
      ],
      "why": "Imprint exiles a card from hand face down (hidden even from its controller), turned face up and put onto the battlefield if a creature when the Egg dies."
    },
    {
      "name": "Tornado Elemental",
      "needs": [
        "static:assign-damage-as-though-unblocked"
      ],
      "why": "\"You may have this creature assign its combat damage as though it weren't blocked\" has no vocabulary."
    },
    {
      "name": "Ion Storm",
      "needs": [
        "cost:remove-counters-from-chosen"
      ],
      "why": "Its cost removes a +1/+1 or charge counter from any permanent you control; removeCounter takes one kind from the source."
    },
    {
      "name": "Myr Quadropod",
      "needs": [
        "effect:switch-pt"
      ],
      "why": "Switching power and toughness (layer 7d) isn't modeled."
    },
    {
      "name": "Roar of Reclamation",
      "needs": [
        "effect:mass-graveyard-to-battlefield"
      ],
      "why": "Each player returns every artifact card from their graveyard at once under their own control; return-from-graveyard reads one graveyard, or puts all under yours."
    },
    {
      "name": "Ouphe Vandals",
      "needs": [
        "effect:counter-ability"
      ],
      "why": "Countering the ability works (Rust), but \"destroy that artifact\" — the countered ability's source — can't be named."
    },
    {
      "name": "Relentless Rats",
      "needs": [
        "mechanic:deck-any-number-copies"
      ],
      "why": "\"A deck can have any number of cards named Relentless Rats\": deck validation exempts only basic lands from the singleton rule."
    },
    {
      "name": "Spectral Shift",
      "needs": [
        "effect:text-change-color-or-land-words"
      ],
      "why": "Changing colour words or basic land types in a permanent's text (rule 612.2) isn't modeled."
    },
    {
      "name": "Myr Servitor",
      "needs": [
        "effect:mass-graveyard-to-battlefield"
      ],
      "why": "Each player returns all cards named Myr Servitor from their graveyard at once, under their own control."
    },
    {
      "name": "Razorgrass Screen",
      "needs": [
        "static:must-block-each-combat"
      ],
      "why": "\"Blocks each combat if able\" has no combat restriction (only must-attack)."
    },
    {
      "name": "Disruption Aura",
      "needs": [
        "cost:pay-mana-cost-of-attached"
      ],
      "why": "Its upkeep cost is the enchanted artifact's own mana cost; an unless-pay takes only a fixed mana string or generic amount."
    },
    {
      "name": "Dawn's Reflection",
      "needs": [
        "effect:mana-any-combination-choice"
      ],
      "why": "\"Two additional mana in any combination of colors\" on a tapped-for-mana trigger fills every unit with one colour."
    },
    {
      "name": "Avarice Totem",
      "needs": [
        "effect:exchange-control"
      ],
      "why": "No exchange-of-control effect."
    },
    {
      "name": "Possessed Portal",
      "needs": [
        "replacement:skip-every-draw"
      ],
      "why": "\"If a player would draw a card, that player skips that draw instead\" — would-draw has no skip form for every player."
