    {
      "name": "Ulrich of the Krallenhorde",
      "needs": [
        "condition:werewolf-transform-spells-last-turn"
      ],
      "why": "Both faces transform on the upkeep check of spells cast last turn, which isn't built."
    },
    {
      "name": "Spell Queller",
      "needs": [
        "effect:exile-target-spell"
      ],
      "why": "Nothing exiles a spell without countering it (an uncounterable spell can still be exiled, the ruling), nor links it to its exiler."
    },
    {
      "name": "Collective Brutality",
      "needs": [
        "cost:escalate-nonmana"
      ],
      "why": "Escalate's per-mode cost is mana only; this one discards a card."
    },
    {
      "name": "Repel the Abominable",
      "needs": [
        "replacement:prevent-all-damage-by-filter"
      ],
      "why": "Preventing all damage, not just combat damage, from non-Human sources isn't built."
    },
    {
      "name": "Soul Separator",
      "needs": [
        "mechanic:double-faced-token"
      ],
      "why": "A token copy of a double-faced creature card must be double-faced (the ruling)."
    },
    {
      "name": "Tangleclaw Werewolf",
      "needs": [
        "static:block-additional-creature"
      ],
      "why": "\"Can block an additional creature each combat\" isn't built."
    },
    {
      "name": "Providence",
      "needs": [
        "mechanic:leyline-opening-hand"
      ],
      "why": "Nothing acts from the opening hand."
    },
    {
      "name": "Thirsting Axe",
      "needs": [
        "filter:dealt-combat-damage-to-creature-this-turn"
      ],
      "why": "Only \"dealt damage to a creature this turn\" exists, not combat damage alone."
    },
    {
      "name": "Slayer's Cleaver",
      "needs": [
        "static:must-be-blocked-by-filter"
      ],
      "why": "\"Must be blocked by an Eldrazi if able\" isn't built."
    },
    {
      "name": "Assembled Alphas",
      "needs": [
        "effect:damage-to-trigger-object"
      ],
      "why": "\"Deals 3 damage to that creature\" (the creature it blocks or that blocks it) needs untargeted damage to the trigger's object."
    },
    {
      "name": "Nephalia Academy",
      "needs": [
        "replacement:discard-to-library-replacement"
      ],
      "why": "Nothing replaces an opponent-caused discard with putting the card on top of the library."
    },
    {
      "name": "Fortune's Favor",
      "needs": [
        "mechanic:face-down-piles-opponent-chooses",
        "decision:separate-into-piles"
      ],
      "why": "No opponent separates cards into a face-down and a face-up pile."
    },
    {
      "name": "Emrakul's Evangel",
      "needs": [
        "effect:sacrifice-any-number",
        "cost:sacrifice-self-and-another"
      ],
      "why": "A cost holds one sacrifice part: \"this creature and any number of other non-Eldrazi creatures\" can't be said."
    },
    {
      "name": "Nahiri's Wrath",
      "needs": [
        "cost:discard-x-cost"
      ],
      "why": "The discard additional cost is a fixed count, and nothing reads the discarded cards' total mana value."
    },
    {
      "name": "Permeating Mass",
