    {
      "name": "Distended Mindbender",
      "needs": [
        "effect:discard-chosen-several-filters"
      ],
      "why": "Nothing has the caster choose one card for each of two filters from a revealed hand and discard them together."
    },
    {
      "name": "Herigast, Erupting Nullkite",
      "needs": [
        "static:grant-emerge"
      ],
      "why": "Emerge is built; giving each creature spell you cast emerge at its mana cost isn't."
    },
    {
      "name": "Crabomination",
      "needs": [
        "effect:cast-during-resolution"
      ],
      "why": "Emerge from artifact is built; casting one of the exiled cards during resolution isn't."
    },
    {
      "name": "Adipose Offspring",
      "needs": [
        "condition:self-emerge-paid"
      ],
      "why": "Emerge is built; \"if its emerge cost was paid\" and the sacrificed creature's toughness on the permanent aren't."
    },
