  "blocked": [
    {
      "name": "Assembly Hall",
      "needs": [
        "effect:may-reveal-from-hand"
      ],
      "why": "Reveal a creature card from your hand, then search for a card with the same name."
    },
    {
      "name": "Blood Oath",
      "needs": [
        "amount:revealed-hand-cards-of-chosen-type"
      ],
      "why": "Nothing counts the cards of a chosen card type in a target opponent's revealed hand."
    },
    {
      "name": "Common Cause",
      "needs": [
        "condition:all-matching-share-a-color"
      ],
      "why": "No condition for \"all nonartifact creatures share a color\"."
    },
    {
      "name": "Cornered Market",
      "needs": [
        "filter:same-name-as-a-permanent"
      ],
      "why": "Can't prohibit casting a spell or playing a nonbasic land with the same name as a nontoken permanent."
    },
    {
      "name": "Deepwood Elder",
      "needs": [
        "static:land-type-setting"
      ],
      "why": "X target lands become Forests until end of turn: replacing land types (305.7) isn't built."
    },
    {
      "name": "Erithizon",
      "needs": [
        "decision:opponent-chooses-target"
      ],
      "why": "Defending player chooses the target of a trigger Erithizon's controller controls."
    },
    {
      "name": "Game Preserve",
      "needs": [
        "effect:each-player-reveals-top-all-match"
      ],
      "why": "Each player reveals their top card and, only if all are creature cards, puts them all onto the battlefield."
    },
    {
      "name": "Horn of Plenty",
      "needs": [
        "effect:delayed-trigger-for-chosen-player"
      ],
      "why": "The end-step draw goes to the spell's caster; a delayed trigger doesn't keep the trigger's spell controller."
    },
    {
      "name": "Ignoble Soldier",
      "needs": [
        "effect:prevent-combat-damage-by-target"
      ],
      "why": "No way to prevent only the combat damage this one creature would deal this turn."
    },
    {
      "name": "Instigator",
      "needs": [
        "effect:restrict-controlled-by-target"
      ],
      "why": "\"Creatures target player controls attack this turn if able\": restrict has no controlled-by-target."
    },
    {
      "name": "Kyren Archive",
      "needs": [
        "effect:exile-top-face-down-linked"
      ],
      "why": "exile-from-library has no face-down, linked-to-source option for a later \"put all cards exiled with it into your hand\"."
    },
    {
      "name": "Ley Line",
      "needs": [
        "target:chosen-by-other-player"
      ],
      "why": "The active player chooses the target of an ability the enchantment's controller controls."
    },
    {
      "name": "Liability",
      "needs": [
        "effect:trigger-object-owner-player-ref"
      ],
      "why": "\"That player\" is the owner of the graveyard the nontoken permanent went to; a dies trigger can only name the permanent's controller."
    },
    {
      "name": "Mercadian Atlas",
      "needs": [
        "condition:played-land-this-turn"
      ],
      "why": "No condition reads whether you played a land this turn."
    },
    {
      "name": "Muzzle",
      "needs": [
        "replacement:prevent-damage-dealt-by-enchanted-creature"
      ],
      "why": "A would-deal-damage replacement can't name the creature this Aura enchants as the source."
    },
    {
      "name": "Port Inspector",
      "needs": [
        "effect:look-at-trigger-player-hand"
      ],
      "why": "look-at-hand takes only a target slot; the defending player isn't targeted."
    },
    {
      "name": "Pretender's Claim",
      "needs": [
        "effect:tap-all-controlled-by-target"
      ],
      "why": "An Aura's becomes-blocked trigger can't tap all lands the defending player controls: tap-all narrows only to a target player."
    },
    {
      "name": "Rappelling Scouts",
      "needs": [
        "effect:grant-protection-temporary"
      ],
      "why": "No effect gives a creature protection from a chosen colour until end of turn; protection is only a static field."
    },
    {
      "name": "Saprazzan Bailiff",
      "needs": [
        "effect:return-from-all-graveyards-to-hand"
      ],
      "why": "Returning all artifact and enchantment cards from all graveyards to their owners' hands isn't expressible."
    },
    {
      "name": "Spiritual Focus",
      "needs": [
        "trigger:discarded-by-opponent-effect"
      ],
      "why": "The discards trigger can't be limited to a discard caused by a spell or ability an opponent controls."
    },
    {
      "name": "Territorial Dispute",
      "needs": [
        "effect:prohibit-land-plays"
      ],
      "why": "No static stops players playing lands while still letting lands be put onto the battlefield."
    },
    {
      "name": "Trap Runner",
      "needs": [
        "effect:becomes-blocked"
      ],
      "why": "No effect makes an unblocked attacking creature become blocked."
    },
    {
      "name": "Unnatural Hunger",
      "needs": [
        "static:other-than-attached"
      ],
      "why": "\"Sacrifice another creature\" must exclude the enchanted creature; the unless-sacrifice option excludes only the Aura itself."
    },
    {
      "name": "Volcanic Wind",
      "needs": [
        "effect:divided-dynamic-total"
      ],
      "why": "A divided total can't be \"the number of creatures on the battlefield as you cast this spell\"."
    }
  ]
}
