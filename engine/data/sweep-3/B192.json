 "blocked": [
  {
   "name": "Oona's Prowler",
   "needs": [
    "cost:any-player-may-activate"
   ],
   "why": "\"Discard a card: … Any player may activate this ability\" — only the controller can activate an ability"
  },
  {
   "name": "Turtleshell Changeling",
   "needs": [
    "effect:switch-pt"
   ],
   "why": "no effect switches a creature's power and toughness (layer 7d)"
  },
  {
   "name": "Ego Erasure",
   "needs": [
    "effect:gain-lose-all-creature-types"
   ],
   "why": "nothing makes a group of creatures lose all creature types until end of turn"
  },
  {
   "name": "Fathom Trawl",
   "needs": [
    "effect:reveal-until-count-to-hand",
    "effect:reveal-until-rest-bottom-any-order"
   ],
   "why": "reveal-until-count puts the found cards only onto the battlefield, and its rest goes only shuffled or in a random order, not the order you choose"
  },
  {
   "name": "Squeaking Pie Sneak",
   "needs": [
    "cost:additional-cost-reveal"
   ],
   "why": "\"reveal a Goblin card from your hand\" as an additional cost: behold also offers a Goblin you control, and behold.fromHand skips the reveal"
  },
  {
   "name": "Ceaseless Searblades",
   "needs": [
    "trigger:activates-mana-ability"
   ],
   "why": "the activates-ability trigger never fires on mana abilities (605.3b), but \"an ability of an Elemental\" includes them"
  },
  {
   "name": "Tideshaper Mystic",
   "needs": [
    "decision:choose-land-type-on-resolution",
    "effect:become-basic-land-type"
   ],
   "why": "no effect makes a land become a basic land type chosen as it resolves, replacing its old land types, until end of turn"
  },
  {
   "name": "Wren's Run Vanquisher",
   "needs": [
    "cost:additional-cost-reveal"
   ],
   "why": "\"reveal an Elf card from your hand\" as an additional cost: behold also offers an Elf you control, and behold.fromHand is a pitch-cost form that never reveals"
  },
  {
   "name": "Favor of the Mighty",
   "needs": [
    "filter:greatest-mana-value-among-all-creatures"
   ],
   "why": "greatestAmongItsController compares each controller's creatures apart; this needs one comparison over every creature on the battlefield, ties sharing it"
  },
  {
   "name": "Thieving Sprite",
   "needs": [
    "effect:reveal-n-from-hand-you-choose-discard"
   ],
   "why": "the target player reveals X cards from their hand of their choice and you choose one to discard; discard-chosen has no count of revealed cards"
  },
  {
   "name": "Nettlevine Blight",
   "needs": [
    "static:aura-grants-ability-referencing-aura",
    "effect:attach-granting-aura"
   ],
   "why": "the granted ability sacrifices its permanent and then attaches the Aura that granted it; a granted ability can't refer to that Aura"
  },
  {
   "name": "Burrenton Forge-Tender",
   "needs": [
    "replacement:prevent-all-damage-from-chosen-source-this-turn"
   ],
   "why": "prevent-damage-from-chosen-source takes only to: you or a slot and the next time or an amount; nothing prevents all of a chosen red source's damage to everything this turn"
  },
  {
   "name": "Twinning Glass",
   "needs": [
    "filter:same-name-as-spell-cast-this-turn"
   ],
   "why": "cast-now's spell filter can't match a name against the spells cast this turn"
  },
  {
   "name": "Hunt Down",
   "needs": [
    "effect:must-block-this-turn"
   ],
   "why": "restrict has no \"blocks that creature this turn if able\" requirement"
  },
  {
   "name": "Flamekin Bladewhirl",
   "needs": [
    "cost:additional-cost-reveal"
   ],
   "why": "\"reveal an Elemental card from your hand\" as an additional cost: behold also offers a permanent, and the from-hand form exiles"
  },
  {
   "name": "Ethereal Whiskergill",
   "needs": [
    "condition:defending-player-controls"
   ],
   "why": "\"can't attack unless defending player controls an Island\": an attack restriction on what the defending player controls isn't expressible"
  },
  {
   "name": "Boggart Forager",
   "needs": [
    "effect:target-player-shuffles-library"
   ],
   "why": "shuffle-library takes no player: only the controller's own library can be shuffled, not target player's"
  },
  {
   "name": "Goldmeadow Stalwart",
   "needs": [
    "cost:additional-cost-reveal"
   ],
   "why": "\"reveal a Kithkin card from your hand\" as an additional cost: behold also offers a permanent, and the from-hand form exiles"
  },
  {
   "name": "Lairwatch Giant",
   "needs": [
    "static:block-additional-creature",
    "trigger:blocks-two-or-more"
   ],
   "why": "nothing lets a creature block an additional creature, and there's no \"blocks two or more creatures\" trigger"
  },
  {
   "name": "Lammastide Weave",
   "needs": [
    "decision:choose-card-name"
   ],
   "why": "no \"choose a card name\" decision"
  }
 ]
}
