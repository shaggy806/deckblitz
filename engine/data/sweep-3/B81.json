 "blocked": [
  {
   "name": "Blade of the Swarm",
   "needs": [
    "effect:target-card-in-exile",
    "condition:filter-has-warp"
   ],
   "why": "The second mode, 'Put target exiled card with warp on the bottom of its owner's library': there's no target spec for a card in exile, and no CardFilter clause for a card that has warp (warp isn't a Keyword)."
  },
  {
   "name": "Close Encounter",
   "needs": [
    "cost:choose-creature-or-warped-card-as-cost"
   ],
   "why": "'As an additional cost, choose a creature you control or a warped creature card you own in exile' and damage equal to the chosen one's power: no additional cost that chooses (not sacrifices) an object across the battlefield and exile, nor an amount reading the chosen one."
  },
  {
   "name": "Cosmogoyf",
   "needs": [
    "bug:cda-cards-owned-in-exile"
   ],
   "why": "Its CDA counts the cards its owner owns in exile (in every zone); setBasePtFromCount has no CountSpec for cards in exile (only battlefield, hand, graveyard, player counters, devotion), and a grantPtPerCount bonus would be layer 7c, not a 7b CDA."
  },
  {
   "name": "Faller's Faithful",
   "needs": [
    "effect:draw-controller-of-target"
   ],
   "why": "\"Its controller draws two cards\" needs draw to name the (last-known) controller of a target slot; draw takes only a who scope or a player target."
  },
  {
   "name": "Fungal Colossus",
   "needs": [
    "effect:distinct-names-count"
   ],
   "why": "\"Costs {X} less, where X is the number of differently named lands you control\": selfCostReduction has no differently-named count (only distinctTokenNames exists, as an EffectAmount, for tokens)."
  },
  {
   "name": "Kav Landseeker",
   "needs": [
    "effect:delayed-trigger-next-turn-end-step"
   ],
   "why": "\"At the beginning of the end step on your next turn, sacrifice that token\": the only own-end-step delayed timing is your-next-end-step, which fires at this turn's end step when the creature enters on your own turn; no timing waits for the end step of your next turn."
  },
  {
   "name": "Lost in Space",
   "needs": [
    "decision:owner-chooses-top-or-bottom"
   ],
   "why": "'Target artifact or creature's owner puts it on their choice of the top or bottom of their library': no effect lets the target's owner choose top or bottom (`each-player-may` reaches only its controller, which differs for a stolen permanent)."
  },
  {
   "name": "Mechan Shieldmate",
   "needs": [
    "stat:turn-history-entered-as-it-entered"
   ],
   "why": "'As long as an artifact entered the battlefield under your control this turn': the `turn-history` `entered` condition matches each entry's filter as the permanent is now (or last was), but the ruling says it doesn't matter whether that artifact stays an artifact — the engine would turn the ability off if it stopped being one, and on for a nonartifact that later became one."
  },
  {
   "name": "Pinnacle Starcage",
   "needs": [
    "effect:exile-all-linked",
    "effect:exiled-with-source-to-graveyard"
   ],
   "why": "\"Exile all artifacts and creatures with mana value 2 or less until this artifact leaves the battlefield\" needs a mass O-Ring (exile-all has no untilSourceLeaves/linked option), and the {6}{W}{W} ability needs to put each card exiled with it into its owner's graveyard and count those for the Robot tokens, which no effect does."
  },
  {
   "name": "Pulsar Squadron Ace",
   "needs": [
    "effect:put-into-hand-this-way"
   ],
   "why": "'If you didn't put a card into your hand this way, put a +1/+1 counter on this creature': `look-and-choose` has a `then` only for when a card was chosen, and no this-way kind reads 'put into your hand'."
  },
  {
   "name": "Scout for Survivors",
   "needs": [
    "decision:target-total-mana-value"
   ],
   "why": "\"Up to three target creature cards with total mana value 3 or less\" needs a total-mana-value relation across a target group; any-number has only maxTotalPower."
  },
  {
   "name": "Skystinger",
   "needs": [
    "trigger:blocks-creature-trigger"
   ],
   "why": "'Whenever this creature blocks a creature with flying': the `blocks` trigger has no filter on the creature blocked, and `blocked-by` (filter on the attacker) has no way to say the blocker is this creature."
  },
  {
   "name": "Starport Security",
   "needs": [
    "cost:ability-cost-reduction-conditional"
   ],
   "why": "\"This ability costs {2} less to activate if you control a creature with a +1/+1 counter on it\": an activated ability's costReduction takes an amount but no condition, so a flat {2} gated on a board condition isn't expressible."
  },
  {
   "name": "Sunstar Chaplain",
   "needs": [
    "cost:remove-counters-from-chosen"
   ],
   "why": "\"Remove a +1/+1 counter from a creature you control\" is a removeCounter cost paid from a chosen permanent other than the source; removeCounter only removes from the source."
  },
  {
   "name": "Tapestry Warden",
   "needs": [
    "static:stations-using-toughness"
   ],
   "why": "Its second static (combatDamageByToughness) exists, but nothing makes a station ability read the tapped creature's toughness instead of its power (crewsAs covers crew and saddle only)."
  },
  {
   "name": "Thaumaton Torpedo",
   "needs": [
    "stat:attacked-with-filter-this-turn",
    "cost:ability-cost-reduction-conditional"
   ],
   "why": "'This ability costs {3} less to activate if you attacked with a Spacecraft this turn': an activated ability's `costReduction` takes no condition, and no turn stat or condition records attacking with a creature matching a filter (Spacecraft)."
  },
  {
   "name": "Tractor Beam",
   "needs": [
    "effect:effect-on-enchanted-permanent",
    "static:doesnt-untap-filter"
   ],
   "why": "'When this Aura enters, tap enchanted permanent' has no effect target for the enchanted permanent, and 'Enchanted permanent doesn't untap during its controller's untap step' can't be said: the static `doesntUntap` only ever applies to the permanent carrying it."
  },
  {
   "name": "Weftwalking",
   "needs": [
    "cost:first-spell-free-each-turn"
   ],
   "why": "\"The first spell each player casts during each of their turns may be cast without paying its mana cost\" has no static: alternativeCostForSpells is the controller's only, an unlimited mana alternative, with no each-player or first-spell-each-turn gate."
  }
 ]
}
