 "blocked": [
  {
   "name": "Alien Symbiosis",
   "needs": [
    "zone:graveyard-self-cast-extra-cost"
   ],
   "why": "\"You may cast this card from your graveyard by discarding a card in addition to paying its other costs\": castFromGraveyardIf takes only a condition and no additional cost, and the castFromGraveyard static (which has sacrifice/payLife/exileOthers, no discard) is a battlefield permission."
  },
  {
   "name": "Hydro-Man, Fluid Felon",
   "needs": [
    "effect:set-types-temporary"
   ],
   "why": "\"Until your next turn, he becomes a land and gains '{T}: Add {U}.' (He's not a creature)\" needs a one-shot effect that replaces the permanent's card types with land for a duration; animate always sets base P/T and only makes creatures, add-types only adds, and setTypes exists only on statics, put-onto-battlefield and copy exceptions."
  },
  {
   "name": "Jackal, Genius Geneticist",
   "needs": [
    "effect:copy-spell-except-nonlegendary"
   ],
   "why": "'Copy that spell, except the copy isn't legendary' — copy-spell has no notLegendary exception (create-token-copy does, a spell copy doesn't), so a copied legendary creature spell would die to the legend rule."
  },
  {
   "name": "Kraven the Hunter",
   "needs": [
    "trigger:dies-greatest-power-lki"
   ],
   "why": "The dies trigger names \"a creature an opponent controls with the greatest power among creatures that player controls\", judged on the board just before the death (rule 603.10a); the greatestAmongItsController filter matches only objects still on the battlefield, so it can never match a creature that died (nor compare a wrath batch against the pre-wrath board)."
  },
  {
   "name": "Kraven's Last Hunt",
   "needs": [
    "effect:aggregate-over-graveyard"
   ],
   "why": "Chapter I's reflexive damage is 'equal to the greatest power among creature cards in your graveyard'; AggregateSpec (and every max amount) reads battlefield permanents only, so there is no greatest-power amount over graveyard cards."
  },
  {
   "name": "Mysterio, Master of Illusion",
   "needs": [
    "effect:tokens-created-with-source"
   ],
   "why": "\"Exile those tokens when Mysterio leaves the battlefield\" needs the tokens created by this ability linked to Mysterio (and the link skipped if he left before they were made, per the ruling); create-token has no such link and a leaves-battlefield exile-all by filter would also exile other Illusion Villain tokens."
  },
  {
   "name": "Origin of Spider-Man",
   "needs": [
    "effect:animate-add-supertype"
   ],
   "why": "Chapter II's \"It becomes a legendary Spider Hero in addition to its other types\" needs a permanent supertype grant, and the add-types effect only adds card types and subtypes (supertypes exist only on copy exceptions)."
  },
  {
   "name": "Rhino's Rampage",
   "needs": [
    "effect:excess-damage-amount"
   ],
   "why": "\"When excess damage is dealt to the creature an opponent controls this way\" is a reflexive trigger on excess damage from this fight specifically; nothing reads excess damage dealt this way (the excessDamageThisTurn filter would also see excess from earlier in the turn, e.g. on an indestructible creature fought by a 0-power one)."
  },
  {
   "name": "Superior Foes of Spider-Man",
   "needs": [
    "zone:impulse-until-next-exile"
   ],
   "why": "\"You may play that card until you exile another card with this creature\" has no impulse-exile duration (only end-of-turn, your-next-turn, your-next-end-step, while-source, while-exiled)."
  },
  {
   "name": "The Spot, Living Portal",
   "needs": [
    "effect:put-on-library-this-way"
   ],
   "why": "The dies trigger's 'put him on the bottom of his owner's library. If you do, return the exiled cards' needs an 'if you do' on put-on-library; nothing records whether that move happened (no this-way kind), and a source-zone 'library' check would wrongly return the cards if he reached the library some other way in response (e.g. Elixir of Immortality) — the linked exile and return-exiled-by-source { linked: 'hand' } themselves exist."
  }
 ]
}
