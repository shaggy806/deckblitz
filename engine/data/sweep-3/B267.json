   "why": "Chapter I's Human token has \"Permanents can't phase in\"; the engine has nothing for it."
  },
  {
   "name": "Kai Winn, Faithless Leader",
   "needs": [
    "trigger:activates-mana-ability"
   ],
   "why": "`activates-ability` never fires for a mana ability, and its source filter sees only battlefield permanents."
  },
  {
   "name": "Scotty, Miracle Worker",
   "needs": [
    "static:grant-beam-me-up-to-graveyard"
   ],
   "why": "Beam me up is only a card's own keyword: nothing grants it to graveyard cards at their mana cost, in your main phase, excluding Scotty as the returned creature."
  },
  {
   "name": "Rules of Acquisition",
   "needs": [
    "effect:draw-former-controller-of-target"
   ],
   "why": "\"That opponent draws three cards\" after you gain control: `controllerOfTarget` reads the new controller; drawing first would reorder draw triggers."
  },
  {
   "name": "Nog, Ambitious Cadet",
   "needs": [
    "static:granted-static-land-permissions"
   ],
   "why": "A granted static's `extraLandsPerTurn` does nothing: `maxLandsFor` reads only printed statics."
  },
  {
   "name": "Ensign Pavel Chekov",
   "needs": [
    "effect:each-opponent-exiles-top-you-choose-one-playable"
   ],
   "why": "Each opponent exiles their top X and you choose a land card among each one's own exiled cards, playable while exiled: no choice is kept to one player's cards."
  },
  {
   "name": "The Caretaker",
   "needs": [
