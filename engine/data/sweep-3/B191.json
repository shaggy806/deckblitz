 "blocked": [
  {
   "name": "Abattoir Ghoul",
   "needs": [
    "filter:damaged-this-turn-by-source"
   ],
   "why": "'Whenever a creature dealt damage by this creature this turn dies' — damagedThisTurnBy matches a source's type, subtype or controller, never this source itself."
  },
  {
   "name": "Heretic's Punishment",
   "needs": [
    "amount:greatest-mana-value-this-way"
   ],
   "why": "'damage equal to the highest mana value among the milled cards' — the milled cards' amount can only sum mana values."
  },
  {
   "name": "Frightful Delusion",
   "needs": [
    "effect:discard-controller-of-target"
   ],
   "why": "'Counter target spell unless its controller pays {1}. That player discards a card.' — discard can't name the controller of the spell in slot 0."
  },
  {
   "name": "Graveyard Shovel",
   "needs": [
    "effect:target-player-exiles-from-graveyard"
   ],
   "why": "'Target player exiles a card from their graveyard. If it's a creature card, you gain 2 life.' — the targeted player can't be the chooser."
  },
  {
   "name": "Bloodlord of Vaasgoth",
   "needs": [
    "effect:cast-spell-gains-bloodthirst"
   ],
   "why": "'Whenever you cast a Vampire creature spell, it gains bloodthirst 3' — nothing gives a spell an enters-with-counters replacement for the permanent it becomes."
  },
  {
   "name": "Arachnus Web",
   "needs": [
    "static:attached-activated-abilities-prohibited"
   ],
   "why": "'Enchanted creature can't attack or block, and its activated abilities can't be activated' — prohibits.abilitiesOf can't name the enchanted creature."
  },
  {
   "name": "Spare from Evil",
   "needs": [
    "effect:grant-protection-temporary"
   ],
   "why": "'Creatures you control gain protection from non-Human creatures until end of turn' — no effect grants protection until end of turn."
  },
  {
   "name": "Essence of the Wild",
   "needs": [
    "replacement:others-enter-as-copy"
   ],
   "why": "'Creatures you control enter as a copy of Essence of the Wild' — copyOnEnter covers only the permanent itself."
  },
  {
   "name": "Arachnus Spinner",
   "needs": [
    "effect:search-library-attach-to-trigger-object"
   ],
   "why": "'search … for a card named Arachnus Web and put it onto the battlefield attached to target creature' — search-library attaches only to its source."
  },
  {
   "name": "Timely Reinforcements",
   "needs": [
    "condition:opponent-more-life"
   ],
   "why": "'If you have less life than an opponent, you gain 6 life' — no condition compares life totals."
  },
  {
   "name": "Harvest Pyre",
   "needs": [
    "cost:exile-x-from-graveyard-additional"
   ],
   "why": "'As an additional cost to cast this spell, exile X cards from your graveyard' — additionalCost.exileFromGraveyard (built this batch) takes a fixed count, not an X."
  },
  {
   "name": "Corpse Lunge",
   "needs": [
    "cost:exiled-card-ref"
   ],
   "why": "'exile a creature card from your graveyard … damage equal to the exiled card's power' — nothing reads which card a cost exiled."
  },
  {
   "name": "Scrambleverse",
   "needs": [
    "effect:random-choice"
   ],
   "why": "'For each nonland permanent, choose a player at random. Then each player gains control of each permanent for which they were chosen' — no random player choice."
  },
  {
   "name": "Vengeful Pharaoh",
   "needs": [
    "trigger:damage-trigger-extensions"
   ],
   "why": "'Whenever combat damage is dealt to you or a planeswalker you control' from the graveyard — deals-damage-batch's to: 'you' doesn't cover your planeswalkers."
  },
  {
   "name": "Stave Off",
   "needs": [
    "effect:grant-protection-choice"
   ],
   "why": "'Target creature gains protection from the color of your choice until end of turn' — no granted protection from a colour chosen as it resolves."
  },
  {
   "name": "Skinshifter",
   "needs": [
    "effect:modal-activated-ability"
   ],
   "why": "'{G}: Choose one — … Activate only once each turn' — an activated ability can't announce its mode as it's activated (rule 700.2b)."
  },
  {
   "name": "Ghostly Possession",
   "needs": [
    "replacement:prevent-damage-by-attached"
   ],
   "why": "'Prevent all combat damage that would be dealt to and dealt by enchanted creature' — a would-deal-damage replacement can't name the enchanted creature."
  },
  {
   "name": "Back from the Brink",
   "needs": [
    "cost:exile-from-graveyard-pay-its-mana-cost"
   ],
   "why": "'Exile a creature card from your graveyard and pay its mana cost: create a token that's a copy of that card' — a cost whose mana is the exiled card's."
  },
  {
   "name": "Night Terrors",
   "needs": [
    "effect:exile-chosen-from-revealed-hand"
   ],
   "why": "'Target player reveals their hand. You choose a nonland card from it. Exile that card.' — the chosen card can only be discarded."
  },
  {
   "name": "Sphinx of Uthuun",
   "needs": [
    "decision:separate-into-piles"
   ],
   "why": "Fact or Fiction's 'an opponent separates those cards into two piles' — no piles decision."
  },
  {
   "name": "Goblin Bangchuckers",
   "needs": [
    "effect:damage-to-source"
   ],
   "why": "'flip a coin. If you win, it deals 2 damage to any target. If you lose, it deals 2 damage to itself' — damage can't name its own source."
  },
  {
   "name": "Doubling Chant",
   "needs": [
    "effect:search-same-name-as-chosen-permanents"
   ],
   "why": "'For each creature you control, you may search your library for a creature card with the same name' — no per-permanent same-name search."
  },
  {
   "name": "Arbalest Elite",
   "needs": [
    "effect:doesnt-untap-your-next-untap-step"
   ],
   "why": "'This creature doesn't untap during your next untap step' — the engine waits for its controller's next untap step, not yours (the ruling: under another player's control, nothing)."
  }
 ]
}
