 "blocked": [
  {
   "name": "Gaddock Teeg",
   "needs": [
    "static:prohibit-cast-by-face"
   ],
   "why": "the can't-cast check reads the card's own characteristics, not the face or half being cast: Fire // Ice's half (mana value 2 per its ruling) would be stopped, and a noncreature Adventure, MDFC back face or bestowed Aura of mana value 4+ on a creature card wrongly allowed"
  },
  {
   "name": "Arbiter of Knollridge",
   "needs": [
    "amount:highest-life-total"
   ],
   "why": "no amount for the highest life total among all players"
  },
  {
   "name": "Ajani Goldmane",
   "needs": [
    "static:cda-life-total"
   ],
   "why": "the −6 Avatar's power and toughness are each equal to your life total: no CDA reads a life total"
  },
  {
   "name": "Cairn Wanderer",
   "needs": [
    "static:gain-abilities-from-graveyard"
   ],
   "why": "keywords copied from creature cards in all graveyards — each protection and every landwalk — have no static"
  },
  {
   "name": "Silvergill Adept",
   "needs": [
    "cost:additional-cost-reveal"
   ],
   "why": "\"reveal a Merfolk card from your hand or pay {3}\": no reveal-from-hand additional cost (behold also allows a Merfolk you control, and exiles)"
  },
  {
   "name": "Sygg, River Guide",
   "needs": [
    "effect:grant-protection-choice"
   ],
   "why": "nothing grants protection from a chosen colour until end of turn"
  },
  {
   "name": "Colfenor's Plans",
   "needs": [
    "static:skip-draw-step"
   ],
   "why": "\"skip your draw step\", and the face-down exile you may look at and play from while it stays"
  },
  {
   "name": "Shields of Velis Vel",
   "needs": [
    "effect:gain-lose-all-creature-types"
   ],
   "why": "every creature type can be granted to one target (`add-types`), not to the creatures a target player controls"
  },
  {
   "name": "Guile",
   "needs": [
    "static:cant-be-blocked-except-by-n",
    "effect:counter-exile-instead"
   ],
   "why": "\"can't be blocked except by three or more creatures\" (only menace's two), and \"counter\" replaced by exile-and-play-free"
  },
  {
   "name": "Dauntless Dourbark",
   "needs": [
    "bug:cda-sum-of-counts"
   ],
   "why": "P/T = Forests plus Treefolk (a Forest Treefolk counted twice, the ruling): `setBasePtFromCount` takes one count"
  },
  {
   "name": "Chandra Nalaar",
   "needs": [
    "cost:loyalty-x"
   ],
   "why": "its −X loyalty ability: `loyaltyCost` is a fixed number"
  },
  {
   "name": "Crush Underfoot",
   "needs": [
    "decision:choose-permanents-keeps-targets"
   ],
   "why": "\"choose a Giant creature you control\" with `choose-permanents` replaces the spell's targets, so its `then` can't reach target creature"
  },
  {
   "name": "Ashling's Prerogative",
   "needs": [
    "decision:choose-odd-or-even"
   ],
   "why": "no odd/even choice as it enters, nor a mana-value parity filter"
  },
  {
   "name": "Fire-Belly Changeling",
   "needs": [
    "cost:activate-no-more-than-n-times-each-turn"
   ],
   "why": "\"activate no more than twice each turn\": only once-per-turn exists"
  },
  {
   "name": "Streambed Aquitects",
   "needs": [
    "static:land-type-setting"
   ],
   "why": "\"target land becomes an Island until end of turn\" sets its land type (rule 305.7); `add-types` only adds, and `animate`'s set needs a P/T"
  },
  {
   "name": "Thoughtweft Trio",
   "needs": [
    "static:can-block-any-number"
   ],
   "why": "\"can block any number of creatures\" — no static lets a creature block more than one (rule 509.1a)"
  },
  {
   "name": "Scattering Stroke",
   "needs": [
    "effect:delayed-trigger-fixed-amount"
   ],
   "why": "the delayed \"add {C} equal to that spell's mana value\" at your next main phase must keep the countered spell's mana value; a delayed trigger has no amount fixed as it's made"
  },
  {
   "name": "Fire Juggler",
   "needs": [
    "effect:damage-each-creature-blocking-source"
   ],
   "why": "clash is built; \"deals 4 damage to each creature blocking it\" has no filter for the creatures blocking the source"
  },
  {
   "name": "Redeem the Lost",
   "needs": [
    "effect:grant-protection-choice"
   ],
   "why": "clash and its self-return are built; protection from the color of your choice until end of turn isn't"
  }
 ]
}
