 "blocked": [
  {
   "name": "Gorex, the Tombshell",
   "needs": [
    "cost:exile-from-graveyard-reduces-cost"
   ],
   "why": "`additionalCost.exileFromGraveyard` has no 'this spell costs {2} less for each card exiled this way'; only `exileFromHandReduces` reduces per card."
  },
  {
   "name": "Etched Slith",
   "needs": [
    "effect:reflexive-trigger-per-counter-put"
   ],
   "why": "Its ruling: the 'when you do' reflexive trigger fires once per +1/+1 counter put (Doubling Season); nothing counts the counters put this way (`thisWay: \"counters-put\"` counts permanents)."
  },
  {
   "name": "Silver Scrutiny",
   "needs": [
    "effect:flash-if-x-at-most"
   ],
   "why": "`flashIf`'s condition is read before X is announced, so 'as though it had flash if X is 3 or less' can't read X."
  },
  {
   "name": "Balduvian Shaman",
   "needs": [
    "filter:has-cumulative-upkeep"
   ],
   "why": "Its target 'white enchantment you control that doesn't have cumulative upkeep': cumulative upkeep is a helper trigger, not a keyword a filter reads."
  },
  {
   "name": "Swirl the Mists",
   "needs": [
    "static:text-change-all-color-words"
