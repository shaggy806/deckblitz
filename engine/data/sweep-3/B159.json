  "blocked": [
    {
      "name": "Emerge Unscathed",
      "needs": [
        "effect:grant-protection-choice"
      ],
      "why": "\"Target creature you control gains protection from the color of your choice until end of turn\": no effect grants protection from a colour chosen as it resolves."
    },
    {
      "name": "Disaster Radius",
      "needs": [
        "cost:reveal-card-as-additional-cost"
      ],
      "why": "\"As an additional cost to cast this spell, reveal a creature card from your hand\" with damage equal to its mana value: no reveal additional cost an amount can read."
    },
    {
      "name": "Shared Discovery",
      "needs": [
        "cost:additional-cost-tap-permanents"
      ],
      "why": "\"As an additional cost to cast this spell, tap four untapped creatures you control\": a spell has no tap-creatures additional cost."
    },
    {
      "name": "Valakut Fireboar",
      "needs": [
        "effect:switch-pt"
      ],
      "why": "\"Whenever this creature attacks, switch its power and toughness until end of turn\": switching power and toughness (layer 7d) isn't modeled."
    },
    {
      "name": "Tajuru Preserver",
      "needs": [
        "static:opponent-cant-cause-sacrifice"
      ],
      "why": "\"Spells and abilities your opponents control can't cause you to sacrifice permanents\": no such rule-changing static."
    },
    {
      "name": "Hellcarver Demon",
      "needs": [
        "effect:sacrifice-all-except-source"
      ],
      "why": "\"Sacrifice all other permanents you control and discard your hand\": sacrifice-all has no exceptSource."
    },
    {
      "name": "Cast Through Time",
      "needs": [
        "effect:grant-rebound-to-spell"
      ],
      "why": "\"Instant and sorcery spells you control have rebound\": grantsToSpells has no rebound field."
    },
    {
      "name": "Mul Daya Channelers",
      "needs": [
        "static:players-play-with-library-top-revealed"
      ],
      "why": "\"Play with the top card of your library revealed\": no such static (what the top card is can be read, but the revealed-library rule isn't modeled)."
    },
    {
      "name": "Dormant Gomazoa",
      "needs": [
        "trigger:player-becomes-target"
      ],
      "why": "\"Whenever you become the target of a spell, you may untap this creature\": becomes-target fires only for permanents."
    },
    {
      "name": "Spawnsire of Ulamog",
      "needs": [
        "mechanic:outside-the-game"
      ],
      "why": "\"{20}: Cast any number of Eldrazi cards you own from outside the game without paying their mana costs\": no outside-the-game zone."
    },
    {
      "name": "Suffer the Past",
      "needs": [
        "target:cards-from-targeted-players-graveyard"
      ],
      "why": "\"Exile X target cards from target player's graveyard\": a graveyard card target can't name the player chosen in another target slot."
    },
    {
      "name": "Explosive Revelation",
      "needs": [
        "effect:reveal-until-rest-bottom-any-order"
      ],
      "why": "\"…then put all cards revealed this way on the bottom of your library in any order\": reveal-until's rest goes in random order only, which would make the player's ordering choice for them."
    },
    {
      "name": "Induce Despair",
      "needs": [
        "cost:reveal-card-as-additional-cost"
      ],
      "why": "\"As an additional cost to cast this spell, reveal a creature card from your hand\" with -X/-X where X is its mana value: no reveal additional cost an amount can read."
    },
    {
      "name": "Venerated Teacher",
      "needs": [
        "filter:has-level-up"
      ],
      "why": "\"Put two level counters on each creature you control with level up\": no filter picks out a permanent with level up."
    },
    {
      "name": "Umbra Mystic",
      "needs": [
        "decision:umbra-armor-choose-aura"
      ],
      "why": "\"Auras you control have umbra armor\": several Auras on one creature would then routinely each have umbra armor, and the engine picks which is destroyed rather than asking the creature's controller (616.1, the rulings; docs/engine-gaps.md)."
    },
    {
      "name": "Recurring Insight",
      "needs": [
        "effect:cards-in-target-player-hand"
      ],
      "why": "\"Draw cards equal to the number of cards in target opponent's hand\": the cardsInHand amount takes a player scope, not a target slot."
    },
    {
      "name": "Haze Frog",
      "needs": [
        "effect:prevent-all-combat-damage-except-source"
      ],
      "why": "\"Prevent all combat damage that other creatures would deal this turn\": prevent-all-combat-damage's filter can't leave out the Frog itself."
    },
    {
      "name": "Reality Spasm",
      "needs": [
        "decision:any-number-targets-in-mode"
      ],
      "why": "\"Choose one — Tap X target permanents; or Untap X target permanents\": a castModal mode can't hold an any-number target group."
    },
    {
      "name": "Khalni Hydra",
      "needs": [
        "cost:self-cost-reduction-colored"
      ],
      "why": "\"This spell costs {G} less to cast for each green creature you control\": selfCostReduction reduces generic mana only."
    },
    {
      "name": "Hedron Matrix",
      "needs": [
        "static:grant-pt-equal-attached-mana-value"
      ],
      "why": "\"Equipped creature gets +X/+X, where X is its mana value\": no amount reads the equipped creature's own mana value."
    },
    {
      "name": "Sarkhan the Mad",
      "needs": [
        "effect:each-creature-deals-power-damage-to-target"
      ],
      "why": "\"−4: Each Dragon creature you control deals damage equal to its power to target player or planeswalker\": no effect has each of several creatures deal its own power in damage."
    },
    {
      "name": "Hedron-Field Purists",
      "needs": [
        "replacement:prevent-n-of-damage"
      ],
      "why": "\"If a source would deal damage to you or a creature you control, prevent 1 of that damage\": the would-deal-damage replacement prevents all of it or adds, never just N."
    },
    {
      "name": "Deprive",
      "needs": [
        "cost:return-permanent-additional-cost"
      ],
      "why": "\"As an additional cost to cast this spell, return a land you control to its owner's hand\": additionalCost has no return-to-hand option."
