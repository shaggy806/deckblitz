  "blocked": [
    {
      "name": "Extract Brain",
      "needs": [
        "effect:opponent-picks-n-from-own-hand-you-may-cast"
      ],
      "why": "A target opponent chooses X cards from their own hand; you look at them and may cast one without paying its mana cost: no shape has the opponent pick from their hand for you to cast from."
    },
    {
      "name": "Memories Returning",
      "needs": [
        "effect:alternating-picks-from-revealed"
      ],
      "why": "Alternating picks between you and a chosen opponent over one revealed pile: look-and-choose has no alternation."
    },
    {
      "name": "Dawnbreak Reclaimer",
      "needs": [
        "effect:mutual-graveyard-choice-return"
      ],
      "why": "You choose a creature card in an opponent's graveyard, then that opponent chooses one in yours, then you may return both: no paired cross-graveyard choice."
    },
    {
      "name": "Forgotten Lore",
      "needs": [
        "effect:repeat-opponent-choice-last-chosen"
      ],
      "why": "repeat's mayAgain cost exists, but nothing keeps the opponent's earlier picks unmoved, bars re-choosing them and puts only the last one into hand."
    },
    {
      "name": "Phyrexian Grimoire",
      "needs": [
        "effect:top-n-of-graveyard-opponent-chooses"
      ],
      "why": "top-of-graveyard gives one card; nothing offers the top two for an opponent to choose between."
    },
    {
      "name": "Bösium Strip",
      "needs": [
        "zone:cast-from-top-of-graveyard"
      ],
      "why": "A graveyard cast permission limited to the top card of the graveyard (and exile it if it would go to a graveyard): castFromGraveyard has no top-card-only option."
    },
    {
      "name": "Spinning Darkness",
      "needs": [
        "cost:alternative-cost-exile-top-of-graveyard"
      ],
      "why": "An alternative cost exiling the top three black cards of your graveyard: the alternativeCost's exileFromGraveyard has no fromTop; only an ability cost has it."
    },
    {
      "name": "Oft-Nabbed Goat",
      "needs": [
        "effect:each-player-other-than-source-owner"
      ],
      "why": "'Each other player' than the dead permanent's owner: no scope, and for-each-player.except takes object refs only. The opponents-may-activate half exists."
    },
    {
      "name": "Teferi, Mage of Zhalfir",
      "needs": [
        "static:grant-flash-to-owned-cards-outside-battlefield"
      ],
      "why": "'Creature cards you own that aren't on the battlefield have flash' is a keyword the cards get (seen by other effects), not castAsThoughFlash's caster permission. Its opponents' sorcery-timing half exists."
    },
    {
      "name": "Flamescroll Celebrant // Revel in Silence",
      "needs": [
        "effect:prohibit-loyalty-abilities-one-shot"
      ],
      "why": "The prohibit effect's abilities is all-or-nothing; only the static prohibits has onlyLoyaltyAbilities, and Revel in Silence's 'this turn' is a one-shot."
    },
    {
      "name": "Abeyance",
      "needs": [
        "effect:prohibit-non-mana-abilities-one-shot"
      ],
      "why": "The prohibit effect (this turn, target player) has no exceptManaAbilities; only the static has it."
    },
    {
      "name": "Taster of Wares",
      "needs": [
        "effect:discard-chosen-reveals-exile-may-cast"
      ],
      "why": "discard-chosen's mayCast is documented 'not with reveals', and the card needs an instant-or-sorcery filter and a 'for as long as you control' duration."
    },
    {
      "name": "Aurora Awakener",
      "needs": [
        "effect:reveal-until-count-put-any-number"
      ],
      "why": "reveal-until-count puts every found card; it can't put 'any number of' them."
    },
    {
      "name": "Old Stickfingers",
      "needs": [
        "effect:reveal-until-count-put-graveyard"
      ],
      "why": "put is battlefield, hand or with-rest; nothing sends the found cards to the graveyard while the rest go to the bottom at random."
    },
    {
      "name": "Kaboom!",
      "needs": [
        "effect:for-each-target-apnap-order"
      ],
      "why": "Its ruling processes the targets in turn order (APNAP); for-each-target uses the order they were chosen."
    },
    {
      "name": "Tawnos, Solemn Survivor",
      "needs": [
        "cost:exile-from-graveyard-beside-sacrifice-several"
      ],
      "why": "An ability cost's exileFromGraveyard is documented not beside a sacrifice of several."
    },
    {
      "name": "Circling Vultures",
      "needs": [
        "static:discard-self-any-time-instant-speed"
      ],
      "why": "'You may discard this card any time you could cast an instant' — a special action from the hand; nothing expresses it."
    },
    {
      "name": "Etrata, Deadly Fugitive",
      "needs": [
        "effect:turn-face-up-or-exile-and-cast"
      ],
      "why": "The granted ability turns the face-down permanent up, and if it can't, exiles it and you may cast it: no can't-turn-up fallback."
    },
    {
      "name": "Hauntwoods Shrieker",
      "needs": [
        "condition:face-down-is-creature-card"
      ],
      "why": "Reveal a face-down permanent and turn it up only if it's a creature card: a condition sees the face-down 2/2, not the hidden card's types."
    },
    {
      "name": "Reservoir Kraken",
      "needs": [
        "effect:each-opponent-may-single-result"
      ],
      "why": "Each opponent may tap an untapped creature; if any player does, you get one Fish (the ruling): each-player-may's ifDid runs once per player who did."
    },
    {
      "name": "Glyph of Reincarnation",
      "needs": [
        "effect:return-from-graveyard-per-died-under-last-blocked-controller"
      ],
      "why": "For each creature that died, return a creature card from the graveyard of whoever controlled it when it was blocked."
    },
    {
      "name": "Glyph of Delusion",
      "needs": [
        "filter:target-blocked-by-other-target"
      ],
      "why": "A target slot filtered on 'blocked by that target Wall this turn': blockedThisTurn.of binds only as an effect applies, so in a target slot it matches nothing."
    },
    {
      "name": "Spellweaver Helix",
      "needs": [
        "keyword:imprint-two-cast-copy-other"
      ],
      "why": "Two imprinted sorceries; when a card with one's name is cast, copy the other exiled card and you may cast the copy."
    },
    {
      "name": "Leyline of Hope",
      "needs": [
