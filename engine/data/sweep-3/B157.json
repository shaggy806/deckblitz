  "blocked": [
    {
      "name": "Crown of Doom",
      "needs": [
        "filter:player-other-than-owner"
      ],
      "why": "\"Target player other than this artifact's owner gains control of it\": a player target can't exclude the source's owner (OtherThan covers only source, trigger object, trigger player and slots)."
    },
    {
      "name": "Impact Resonance",
      "needs": [
        "amount:greatest-damage-by-one-source-this-turn"
      ],
      "why": "No amount reads the greatest damage a single source dealt to one permanent or player this turn; X is fixed as it's cast for the division (rulings)."
    },
    {
      "name": "Meandering Towershell",
      "needs": [
        "effect:delayed-return-attacking-next-turn"
      ],
      "why": "Nothing returns an exiled card tapped and attacking at your next turn's declare-attackers step, attacking a player or planeswalker chosen then."
    },
    {
      "name": "Watcher of the Roost",
      "needs": [
        "cost:morph-reveal-card"
      ],
      "why": "Its morph cost is \"Reveal a white card in your hand\": a morph cost that isn't mana isn't modeled."
    },
    {
      "name": "Wolfcaller's Howl",
      "needs": [
        "condition:that-player-hand-size"
      ],
      "why": "\"The number of your opponents with four or more cards in hand\": countPlayers takes no filter and hand-size reads only you or each player."
    },
    {
      "name": "Volcanic Offering",
      "needs": [
        "decision:opponent-chooses-target"
      ],
      "why": "Two of its targets are chosen by an opponent you pick as you cast it; nothing models an opponent choosing a spell's targets."
    },
    {
      "name": "Bitter Feud",
      "needs": [
        "decision:choose-player-on-enter",
        "replacement:chosen-players-damage-doubling"
      ],
      "why": "\"As this enters, choose two players\" isn't modeled, nor doubling damage only between the two chosen players."
    },
    {
      "name": "Incite Rebellion",
      "needs": [
        "amount:count-that-player-controls"
      ],
      "why": "Inside for-each-player nothing counts \"creatures that player controls\"."
    },
    {
      "name": "Feat of Resistance",
      "needs": [
        "effect:grant-protection-choice"
      ],
      "why": "No one-shot \"gains protection from the color of your choice until end of turn\" effect; protection is a static only."
    },
    {
      "name": "Smoke Teller",
      "needs": [
        "effect:look-at-face-down-permanents"
      ],
      "why": "No effect for \"look at target face-down creature\"."
    },
    {
      "name": "Domineering Will",
      "needs": [
        "effect:must-block-this-turn"
      ],
      "why": "The restrictions have no \"blocks this turn if able\" requirement."
    },
    {
      "name": "Grave Sifter",
      "needs": [
        "effect:each-player-chooses-creature-type"
      ],
      "why": "choose-creature-type always asks the effect's controller; each player can't choose their own type."
    },
    {
      "name": "Ashcloud Phoenix",
      "needs": [
        "effect:put-onto-battlefield-face-down"
      ],
      "why": "put-onto-battlefield can't return a card face down."
    },
    {
      "name": "Temur Charger",
      "needs": [
        "cost:morph-reveal-card"
      ],
      "why": "Its morph cost is \"Reveal a green card in your hand\": not mana."
    },
    {
      "name": "Horde Ambusher",
      "needs": [
        "cost:morph-reveal-card"
      ],
      "why": "Its morph cost is \"Reveal a red card in your hand\": not mana."
    },
    {
      "name": "Herald of Anafenza",
      "needs": [
        "trigger:activates-this-ability"
      ],
      "why": "activates-ability can't be narrowed to this creature's own outlast ability; folding the token into outlast's effect would change when it can be responded to."
    },
    {
      "name": "Arrow Storm",
      "needs": [
        "effect:damage-cant-be-prevented"
      ],
      "why": "The damage effect has no \"can't be prevented\" option for the raid mode."
    },
    {
      "name": "Stitcher Geralf",
      "needs": [
        "amount:this-way-total-power-of-cards"
      ],
      "why": "\"The total power of the cards exiled this way\": sumOf reads 0 power for a card off the battlefield (powerAmong reads mana value in public zones but not power), so the Zombie would enter 0/0."
    },
    {
      "name": "Dulcet Sirens",
      "needs": [
        "effect:target-attacks-target-player-this-turn"
      ],
      "why": "Nothing makes a creature attack one chosen player this turn if able."
    },
    {
      "name": "Zurgo Helmsmasher",
      "needs": [
        "trigger:dies-after-dealt-damage-by-source"
      ],
      "why": "The dealt-damage-this-turn filter names a source only by type, subtype or controller, not \"this creature\"."
    },
    {
      "name": "Thousand Winds",
      "needs": [
        "effect:return-to-hand-all-except-source"
      ],
      "why": "The mass bounce can't leave out its own source (\"all other tapped creatures\")."
    },
    {
      "name": "Ruthless Ripper",
      "needs": [
        "cost:morph-reveal-card"
      ],
      "why": "Its morph cost is \"Reveal a black card in your hand\": not mana."
    },
    {
      "name": "Dragon's Eye Savants",
      "needs": [
        "cost:morph-reveal-card",
        "effect:look-at-target-player-hand"
      ],
      "why": "Morph by revealing a blue card, and no \"look at target opponent's hand\" effect."
    },
    {
      "name": "Lens of Clarity",
      "needs": [
        "effect:look-at-face-down-permanents"
      ],
      "why": "Looking at the top card is expressible; looking at opponents' face-down creatures isn't."
    },
    {
      "name": "Burn Away",
      "needs": [
        "effect:exile-graveyard-of-trigger-object-controller"
      ],
      "why": "The delayed trigger can't reach \"its controller's graveyard\": exiling a graveyard needs a player target or scope."
    },
    {
      "name": "Siege Behemoth",
      "needs": [
        "static:assign-damage-as-though-unblocked"
      ],
      "why": "No way to say \"you may have each creature assign its combat damage as though it weren't blocked\"."
    },
    {
      "name": "Ob Nixilis of the Black Oath",
      "needs": [
        "effect:emblem-grants-activated"
      ],
      "why": "create-emblem carries statics and triggered abilities, not the −8 emblem's activated ability."
    },
    {
      "name": "Loreseeker's Stone",
      "needs": [
        "cost:ability-cost-increase-per-count"
      ],
      "why": "An ability's costReduction only reduces: \"costs {1} more for each card in your hand\" can't be said."
    },
    {
      "name": "Ride Down",
      "needs": [
        "filter:blocked-or-blocked-by-filter-this-turn"
      ],
      "why": "Nothing picks out \"creatures that were blocked by that creature this combat\" to give them trample."
    },
    {
      "name": "Dragon Grip",
      "needs": [
        "effect:self-flash-if-condition"
      ],
      "why": "No card-level \"you may cast this spell as though it had flash if [ferocious]\"."
    },
    {
      "name": "Avalanche Tusker",
      "needs": [
        "effect:must-block-this-turn"
      ],
      "why": "No restriction for \"target creature blocks this creature this combat if able\"."
    }
  ]
}
