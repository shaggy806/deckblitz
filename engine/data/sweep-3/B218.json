 "blocked": [
  {
   "name": "Squee's Revenge",
   "needs": [
    "decision:choose-number-on-resolution",
    "mechanic:coin-flip"
   ],
   "why": "Choose a number as it resolves, then flip that many coins or until one is lost, rewarding each flip only if all were won."
  },
  {
   "name": "Unnatural Selection",
   "needs": [
    "effect:set-creature-type",
    "decision:choose-creature-type-excluding"
   ],
   "why": "Nothing makes a creature become a chosen creature type (replacing its types), and the type choice can't exclude Wall."
  },
  {
   "name": "Cromat",
   "needs": [
    "filter:blocking-or-blocked-by-source"
   ],
   "why": "No target filter for 'creature blocking or blocked by this creature'; its other abilities are expressible."
  },
  {
   "name": "Desolation Giant",
   "needs": [
    "effect:destroy-all-except-source"
   ],
   "why": "'Destroy all other creatures' — destroy-all can't spare its source."
  },
  {
   "name": "Standard Bearer",
   "needs": [
    "static:must-target-flagbearer"
   ],
   "why": "Nothing makes opponents choose a Flagbearer when they choose targets (rule 702-style targeting requirement)."
  },
  {
   "name": "Coalition Flag",
   "needs": [
    "static:must-target-flagbearer"
   ],
   "why": "Enchanted creature is a Flagbearer — the Flagbearer targeting requirement isn't built."
  },
  {
   "name": "Coalition Honor Guard",
   "needs": [
    "static:must-target-flagbearer"
   ],
   "why": "The Flagbearer targeting requirement isn't built."
  },
  {
   "name": "Bloodfire Infusion",
   "needs": [
    "cost:sacrifice-enchanted-creature"
   ],
   "why": "A sacrifice cost can't name the creature this Aura enchants."
  },
  {
   "name": "Dead Ringers",
   "needs": [
    "condition:targets-same-colors"
   ],
   "why": "No resolution check that two targets have exactly the same colours."
  },
  {
   "name": "Gerrard Capashen",
   "needs": [
    "effect:cards-in-target-player-hand"
   ],
   "why": "'1 life for each card in target opponent's hand' — cardsInHand can't read a target slot."
  },
  {
   "name": "Reef Shaman",
   "needs": [
    "effect:set-land-type"
   ],
   "why": "No effect makes a target land a chosen basic land type, replacing its types and abilities (rule 305.7)."
  },
  {
   "name": "Tundra Kavu",
   "needs": [
    "effect:set-land-type"
   ],
   "why": "Target land becomes a Plains or an Island — the same missing land-type-setting effect."
  },
  {
   "name": "Captain's Maneuver",
   "needs": [
    "target:creature-planeswalker-or-player"
   ],
   "why": "No target slot for 'creature, planeswalker or player' without battles."
  },
  {
   "name": "Suppress",
   "needs": [
    "effect:exile-hands-face-down-return-later"
   ],
   "why": "Exiling a hand face down and returning it at the end step of that player's next turn has no shape."
  },
  {
   "name": "Shimmering Mirage",
   "needs": [
    "effect:become-basic-land-type",
    "decision:choose-land-type-on-resolution"
   ],
   "why": "Setting a land's basic type until end of turn, stripping its other abilities (rule 305.7), isn't built."
  },
  {
   "name": "Divine Light",
   "needs": [
    "replacement:prevent-damage-to-filter-this-turn"
   ],
   "why": "A one-shot 'prevent all damage this turn to creatures you control' that covers creatures arriving later."
  },
  {
   "name": "Ice Cave",
   "needs": [
    "effect:other-player-may-pay-spell-mana-cost"
   ],
   "why": "Any other player may pay the spell's printed mana cost to counter it — no such unless-option."
  },
  {
   "name": "Mind Extraction",
   "needs": [
    "effect:discard-all-matching",
    "filter:shares-color-with-sacrificed"
   ],
   "why": "Discard every card sharing a colour with the sacrificed creature: no discard-all-matching effect or filter."
  },
  {
   "name": "Dodecapod",
   "needs": [
    "replacement:discarded-by-opponent-to-battlefield"
   ],
   "why": "'If an opponent's spell or ability causes you to discard this, put it onto the battlefield instead' isn't built."
  },
  {
   "name": "Zombie Boa",
   "needs": [
    "decision:choose-color-on-resolution",
    "filter:chosen-color"
   ],
   "why": "Its 'becomes blocked by a creature of the chosen colour' trigger can't key on a colour chosen as the ability resolves."
  },
  {
   "name": "Guided Passage",
   "needs": [
    "effect:choices-by-other-players"
   ],
   "why": "An opponent chooses a creature, a land and a noncreature nonland card from your library — not built."
  },
  {
   "name": "Symbiotic Deployment",
   "needs": [
    "static:skip-draw-step"
   ],
   "why": "No static for 'skip your draw step'."
  },
  {
   "name": "Emblazoned Golem",
   "needs": [
    "keyword:kicker-x",
    "amount:colored-mana-spent-on-x"
   ],
   "why": "Kicker {X} payable only with coloured mana, at most one of each colour."
  },
  {
   "name": "False Dawn",
   "needs": [
    "replacement:mana-production-replacement",
    "cost:spend-mana-as-any-color"
   ],
   "why": "Turning produced mana white until end of turn and spending white as any colour as a one-shot effect."
  },
  {
   "name": "Tahngarth's Glare",
   "needs": [
    "effect:look-at-target-player-library-reorder"
   ],
   "why": "Look at and reorder another player's library — look-and-choose makes that player the one who looks."
  },
  {
   "name": "Urborg Lhurgoyf",
   "needs": [
    "replacement:as-enters-mill"
   ],
   "why": "Its two kickers are built (B218); 'as this creature enters, mill three cards for each time it was kicked' isn't."
  }
