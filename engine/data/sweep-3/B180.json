 "blocked": [
  {
   "name": "Advice from the Fae",
   "needs": [
    "condition:player-controls-most"
   ],
   "why": "\"If you control more creatures than each other player\": opponent-controls-more is strictly greater, ties wrong."
  },
  {
   "name": "Deus of Calamity",
   "needs": [
    "trigger:deals-damage-amount-threshold"
   ],
   "why": "\"Deals 6 or more damage to an opponent\": the deals-damage trigger has exactly but no N-or-more."
  },
  {
   "name": "Din of the Fireherd",
   "needs": [
    "effect:sacrifice-amount"
   ],
   "why": "\"Target opponent sacrifices a creature for each black creature you control\": sacrifice's count is a fixed number only."
  },
  {
   "name": "Dream Salvage",
   "needs": [
    "effect:turn-stat-cards-discarded"
   ],
   "why": "\"Draw cards equal to the number of cards target opponent discarded this turn\": no count of cards a player discarded this turn."
  },
  {
   "name": "Elsewhere Flask",
   "needs": [
    "static:land-type-setting"
   ],
   "why": "Lands you control become the chosen basic land type until end of turn; no such effect (and decision:choose-land-type-on-resolution)."
  },
  {
   "name": "Furystoke Giant",
   "needs": [
    "effect:grant-activated-all-except-source"
   ],
   "why": "\"Other creatures you control gain …\" an activated ability until end of turn: grant-activated-all has no exceptSource."
  },
  {
   "name": "Ghastlord of Fugue",
   "needs": [
    "effect:exile-chosen-from-revealed-hand"
   ],
   "why": "Choose a card from the revealed hand and exile it: discard-chosen only discards."
  },
  {
   "name": "Moonring Island",
   "needs": [
    "effect:look-at-target-player-library"
   ],
   "why": "\"Look at the top card of target player's library\": look-and-choose reaches only your library or a chosen opponent's."
  },
  {
   "name": "Mossbridge Troll",
   "needs": [
    "replacement:regenerate-instead-of-destroy",
    "cost:tap-creatures-total-power"
   ],
   "why": "\"If it would be destroyed, regenerate it\" isn't built, nor tapping any number of other creatures with total power 10 or more as a cost."
  },
  {
   "name": "Prison Term",
   "needs": [
    "static:attached-activated-abilities-prohibited"
   ],
   "why": "\"Its activated abilities can't be activated\" for the enchanted creature: nothing singles out the Aura's host."
  },
  {
   "name": "Puca's Mischief",
   "needs": [
    "effect:exchange-control"
   ],
   "why": "Exchange control of target nonland permanent you control and target nonland permanent an opponent controls with an equal or lesser mana value: no control exchange, and the second target's mana value reads the first's."
  },
  {
   "name": "Rosheen Meanderer",
   "needs": [
    "cost:mana-spend-only-x-costs"
   ],
   "why": "\"Spend this mana only on costs that contain {X}\": spendOnly can name spells with {X} in their mana cost, not activated abilities' {X} costs."
  },
  {
   "name": "Runed Halo",
   "needs": [
    "decision:choose-card-name",
    "effect:player-protection"
   ],
   "why": "Naming a card, and protection for a player from the chosen name."
  },
  {
   "name": "Savor the Moment",
   "needs": [
    "effect:skip-next-untap-step"
   ],
   "why": "\"Skip the untap step of that turn\": take-extra-turn can't skip the extra turn's own untap step."
  },
  {
   "name": "Swans of Bryn Argoll",
   "needs": [
    "effect:damage-source-controller-draws"
   ],
   "why": "Prevent the damage; the source's controller draws that many — nothing names the damage source's controller."
  },
  {
   "name": "Tatterkite",
   "needs": [
    "static:cant-have-counters-self"
   ],
   "why": "\"Can't have counters put on it\", for itself as it enters (persist's -1/-1 counter): preventsCounters has no self scope."
  },
  {
   "name": "Torrent of Souls",
   "needs": [
    "effect:grant-keyword-all-target-player"
   ],
   "why": "\"Creatures target player controls gain haste\": grant-keyword-all has no controlledByTarget."
  },
  {
   "name": "Twilight Shepherd",
   "needs": [
    "condition:return-cards-put-in-graveyard-from-battlefield-this-turn"
   ],
   "why": "\"Return to your hand each card put into your graveyard from the battlefield this turn\": no filter picks those cards out."
  },
  {
   "name": "Wheel of Sun and Moon",
   "needs": [
    "replacement:graveyard-to-library-bottom-instead"
   ],
   "why": "\"Reveal it and put it on the bottom of its owner's library instead\", scoped to the enchanted player: the replacement only exiles."
  },
  {
   "name": "Wilt-Leaf Liege",
   "needs": [
    "replacement:discarded-by-opponent-to-battlefield"
   ],
   "why": "Discarded by an opponent's effect, put it onto the battlefield instead."
  }
 ]
}
