   "name": "Spellweaver Volute",
   "needs": [
    "mechanic:enchant-card-in-graveyard"
   ],
   "size": "major",
   "why": "An Aura that enchants a card in a graveyard: a new kind of attachment outside the battlefield (legality, the copy-and-cast, reattaching to another graveyard card). Not attempted; for the user."
  },
  {
   "name": "Word of Command",
   "needs": [
    "mechanic:control-player-while-resolving"
   ],
   "size": "major",
   "why": "Controlling another player while the spell resolves, with that player's mana-ability limits: a new subsystem. Not attempted; for the user."
  },
  {
   "name": "Swirl the Mists",
   "needs": [
    "static:text-change-all-color-words"
   ],
   "size": "major",
   "why": "A static that changes the text of every spell and permanent: text changes are per-object (rulesTextName/textChangesOf), so reaching a spell as it's cast (601.2a-c) and each permanent as it enters needs a new text-changing subsystem."
  },
  {
   "name": "Raging River",
   "needs": [
    "effect:block-restricted-to-labeled-pile"
   ],
   "size": "major",
   "why": "Each defender splits creatures into labelled piles no one chooses between, kept through a later per-attacker left/right choice in the same resolution: a new decision with its own UI and a new pile strategy for the bots."
  },
  {
   "name": "Rhystic Cave",
   "needs": [
    "cost:pay-unless-inside-mana-ability"
   ],
   "size": "major",
   "why": "Its {1} would be paid by the auto-planner, choosing the payer's lands for them (rule zero); there is no payment window where a payer picks sources, and none inside a mana ability. A working build with the auto-planner is kept in commit 67ce0c3cb (revert 65e583c45 once such a window exists)."
  },
  {
   "name": "Balduvian Fallen",
   "needs": [
    "amount:mana-spent-on-cumulative-upkeep"
   ],
   "size": "small",
   "why": "Re-keyed: trigger:cumulative-upkeep-paid is built (B338), but it still needs the {B} or {R} spent paying the upkeep."
  }
