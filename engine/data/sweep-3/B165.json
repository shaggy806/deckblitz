  "blocked": [
    {
      "name": "Quest for Pure Flame",
      "needs": [
        "replacement:double-damage-from-your-sources-this-turn"
      ],
      "why": "\"If a source you control would deal damage this turn, it deals double\" — player-effect damageTo doubles damage from any source, not only yours."
    },
    {
      "name": "Summoning Trap",
      "needs": [
        "condition:creature-spell-countered-by-opponent-this-turn"
      ],
      "why": "No turn history records a creature spell of yours countered by an opponent, so the trap's condition can't be stated."
    },
    {
      "name": "Guul Draz Specter",
      "needs": [
        "condition:opponent-hand-size"
      ],
      "why": "\"As long as an opponent has no cards in hand\" — hand-size covers only you or each player."
    },
    {
      "name": "Bala Ged Thief",
      "needs": [
        "effect:reveal-n-from-hand-you-choose-discard"
      ],
      "why": "The target player chooses N cards to reveal, then you choose one of those to discard."
    },
    {
      "name": "Blazing Torch",
      "needs": [
        "cost:granted-ability-sacrifice-granter"
      ],
      "why": "The granted ability sacrifices the Equipment, and the damage's source is the Equipment."
    },
    {
      "name": "Armament Master",
      "needs": [
        "effect:count-equipment-attached-to-source"
      ],
      "why": "Its bonus counts the Equipment attached to it; grantPtPerCount can't count those."
    },
    {
      "name": "Magosi, the Waterveil",
      "needs": [
        "replacement:skip-turn"
      ],
      "why": "No \"skip your next turn\" effect."
    },
    {
      "name": "Turntimber Basilisk",
      "needs": [
        "effect:must-block-this-turn"
      ],
      "why": "No effect makes a target creature block this creature this turn if able."
    },
    {
      "name": "Nissa's Chosen",
      "needs": [
        "replacement:dies-to-library-bottom"
      ],
      "why": "\"If this would die, put it on the bottom of its owner's library instead\" — the only dies redirect is to exile."
    },
    {
      "name": "Unstable Footing",
      "needs": [
        "effect:damage-cant-be-prevented"
      ],
      "why": "No \"damage can't be prevented this turn\" effect."
    },
    {
      "name": "Desecrated Earth",
      "needs": [
        "effect:discard-controller-of-target"
      ],
      "why": "\"Its controller discards a card\" — discard can't name the target's controller."
    },
    {
      "name": "Trapfinder's Trick",
      "needs": [
        "effect:discard-all-matching"
      ],
      "why": "No effect discards every card in a hand matching a filter."
    },
    {
      "name": "Gomazoa",
      "needs": [
        "filter:creature-source-is-blocking"
      ],
      "why": "Shuffling each creature it's blocking along with it needs a \"blocked by this\" scope."
    },
    {
      "name": "Vampire Hexmage",
      "needs": [
        "effect:remove-all-counters"
      ],
      "why": "Removing every counter of every kind; remove-counter names one kind."
    },
    {
      "name": "Grappling Hook",
      "needs": [
        "effect:must-block-this-turn"
      ],
      "why": "No effect makes a target creature block the equipped creature this turn if able."
    },
    {
      "name": "Cobra Trap",
      "needs": [
        "condition:noncreature-permanent-destroyed-by-opponent-this-turn"
      ],
      "why": "Turn history keeps no record of permanents destroyed or who controlled the destroying spell or ability."
    },
    {
      "name": "Inferno Trap",
      "needs": [
        "stat:filter-dealt-damage-to-you-this-turn"
      ],
      "why": "No count of how many different creatures dealt you damage this turn."
    },
    {
      "name": "Kabira Evangel",
      "needs": [
        "decision:choose-color-on-resolution",
        "effect:grant-protection-temporary"
      ],
      "why": "Protection from a colour chosen as it resolves, until end of turn — protection is only a static."
    },
    {
      "name": "Cosi's Trickster",
      "needs": [
        "trigger:opponent-shuffles-library"
      ],
      "why": "No trigger for a player shuffling their library."
    },
    {
      "name": "Sadistic Sacrament",
      "needs": [
        "effect:search-opponent-library"
      ],
      "why": "Searching a target player's library and exiling what's found."
    },
    {
      "name": "Ravenous Trap",
      "needs": [
        "condition:put-into-graveyard-this-turn-any-zone"
      ],
      "why": "No turn stat counts cards put into an opponent's graveyard from anywhere this turn."
    },
    {
      "name": "Hellfire Mongrel",
      "needs": [
        "condition:that-player-hand-size"
      ],
      "why": "The intervening-if checks the active opponent's hand; hand-size covers only you or each player."
    },
    {
      "name": "Lullmage Mentor",
      "needs": [
        "trigger:counters-a-spell-trigger"
      ],
      "why": "No \"whenever a spell or ability you control counters a spell\" trigger."
    },
    {
      "name": "Spreading Seas",
      "needs": [
        "static:land-type-setting"
      ],
      "why": "\"Enchanted land is an Island\" must remove the land's own abilities (rule 305.7); setSubtypes doesn't."
    },
    {
      "name": "Pyromancer Ascension",
      "needs": [
        "filter:same-name-as-card-in-graveyard"
      ],
      "why": "\"A spell that has the same name as a card in your graveyard\" — only nameUnlike exists, the opposite."
    },
    {
      "name": "Lavaball Trap",
      "needs": [
        "condition:turn-history-per-player"
      ],
      "why": "\"An opponent had two or more lands enter\" must be one opponent; turn-history with who: opponent sums across all opponents."
    }
  ]
}
