  "blocked": [
    {
      "name": "Feast on the Fallen",
      "needs": [
        "condition:lost-life-last-turn"
      ],
      "why": "\"If an opponent lost life last turn\": the turn-stat conditions read this turn only."
    },
    {
      "name": "Avacyn, Guardian Angel",
      "needs": [
        "replacement:prevent-damage-from-colored-sources"
      ],
      "why": "Prevent all damage dealt by sources of a colour chosen as it resolves: prevent-damage has no source filter."
    },
    {
      "name": "Might Makes Right",
      "needs": [
        "condition:greatest-power-condition"
      ],
      "why": "\"If you control each creature with the greatest power\": controls-greatest accepts a tie with an opponent's creature."
    },
    {
      "name": "Master of Predicaments",
      "needs": [
        "decision:opponent-guesses-mana-value"
      ],
      "why": "An opponent guesses whether a hidden card's mana value is greater than 4."
    },
    {
      "name": "Jace, the Living Guildpact",
      "needs": [
        "effect:shuffle-hand-and-graveyard-into-library"
      ],
      "why": "The −8 shuffles each player's hand and graveyard into their library; only the graveyard half exists."
    },
    {
      "name": "Stain the Mind",
      "needs": [
        "decision:choose-card-name",
        "effect:extract-same-name"
      ],
      "why": "Name a card, then search graveyard, hand and library for it."
    },
    {
      "name": "Magister of Worth",
      "needs": [
        "effect:destroy-all-except-source"
      ],
      "why": "Council's dilemma's \"destroy all creatures other than this creature\": destroy-all can't leave its source out."
    },
    {
      "name": "Council Guardian",
      "needs": [
        "effect:grant-protection-choice"
      ],
      "why": "Protection from each colour with the most votes or tied: no one-shot protection grant, and vote-won is a strict majority."
    },
    {
      "name": "Grenzo's Rebuttal",
      "needs": [
        "decision:each-player-chooses-permanents-of-left-player"
      ],
      "why": "Each player chooses an artifact, a creature and a land of the player to their left; all are destroyed at once."
    },
    {
      "name": "Phytotitan",
      "needs": [
        "effect:delayed-trigger-owners-next-upkeep"
      ],
      "why": "Returns at its owner's next upkeep; the delays wait on the ability controller's."
    },
    {
      "name": "Resolute Archangel",
      "needs": [
        "effect:life-total-becomes",
        "amount:starting-life-total"
      ],
      "why": "\"Your life total becomes your starting life total\": no amount reads the starting life total."
    },
    {
      "name": "First Response",
      "needs": [
        "condition:lost-life-last-turn"
      ],
      "why": "\"If you lost life last turn\": the turn-stat conditions read this turn only."
    },
    {
      "name": "Shield of the Avatar",
      "needs": [
        "replacement:prevent-n-of-damage"
      ],
      "why": "Prevents X of the damage, X your creatures: a damage replacement prevents all or nothing."
    },
    {
      "name": "Grenzo, Dungeon Warden",
      "needs": [
        "effect:mill-from-bottom"
      ],
      "why": "Puts the bottom card of your library into your graveyard and acts on it."
    },
    {
      "name": "Realm Seekers",
      "needs": [
        "amount:entering-card-counts-itself-in-hand"
      ],
      "why": "Counts itself when put onto the battlefield from a hand (ruling); the enters-with amount reads after it left."
    },
    {
      "name": "Aggressive Mining",
      "needs": [
        "effect:prohibit-land-plays"
      ],
      "why": "\"You can't play lands\": prohibits covers spells and abilities only."
    },
    {
      "name": "Goblin Kaboomist",
      "needs": [
        "effect:damage-to-source"
      ],
      "why": "\"This creature deals 2 damage to itself\": the damage effect's target can't name the source."
    },
    {
      "name": "Siege Dragon",
      "needs": [
        "condition:defending-player-controls"
      ],
      "why": "\"If defending player controls no Walls\": no condition reads the defending player's permanents."
    },
    {
      "name": "Necromancer's Stockpile",
      "needs": [
        "effect:cost-discarded-card-ref"
      ],
      "why": "\"If the discarded card was a Zombie card\": the card discarded for the cost isn't readable as the ability resolves."
    },
    {
      "name": "Blastfire Bolt",
      "needs": [
        "condition:attached-to-target"
      ],
      "why": "\"Destroy all Equipment attached to that creature\": a filter can't point attachedTo at a target slot."
    },
    {
      "name": "Soul of Shandalar",
      "needs": [
        "target:controlled-by-target-player"
      ],
      "why": "Up to one creature controlled by the player (or planeswalker's controller) the first target names."
    },
    {
      "name": "Brood Keeper",
      "needs": [
        "trigger:becomes-attached"
      ],
      "why": "\"Whenever an Aura becomes attached to this creature\" — moving onto it too (ruling)."
    },
    {
      "name": "Brago's Representative",
      "needs": [
        "static:extra-vote"
      ],
      "why": "\"You get an additional vote\" is mandatory; votesAdditionalTime is a may."
    },
    {
      "name": "Grudge Keeper",
      "needs": [
        "effect:opponents-who-voted-otherwise-scope"
      ],
      "why": "\"Each opponent who voted for a choice you didn't vote for loses 2 life.\""
    },
    {
      "name": "Boonweaver Giant",
      "needs": [
        "effect:search-hand-graveyard-library"
      ],
      "why": "Searches graveyard, hand and/or library for an Aura; search-library's zones leave out the hand."
    },
    {
      "name": "Custodi Squire",
      "needs": [
        "effect:vote-for-card-in-graveyard"
      ],
      "why": "Each player votes for an artifact, creature or enchantment card in your graveyard."
    },
    {
      "name": "Innocuous Researcher",
      "needs": [
        "effect:prohibit-until-your-next-turn"
      ],
      "why": "Re-triaged (B91 had parley alone, built this batch): \"you can't cast spells until your next turn\" — prohibit lasts this turn only."
    }
  ]
