 "blocked": [
  {
   "name": "Jeleva, Nephalia's Scourge",
   "needs": [
    "effect:linked-exiled-card"
   ],
   "why": "exile-from-library doesn't link the cards to Jeleva, so 'cast an instant or sorcery card exiled with Jeleva' can't find them"
  },
  {
   "name": "Witch Hunt",
   "needs": [
    "effect:random-target"
   ],
   "why": "'target opponent chosen at random' — no random target spec"
  },
  {
   "name": "Eye of Doom",
   "needs": [
    "effect:each-player-chooses-then-all-act"
   ],
   "why": "each player chooses a nonland permanent (mandatory) and doom counters go on all of them"
  },
  {
   "name": "Widespread Panic",
   "needs": [
    "trigger:opponent-shuffles-library"
   ],
   "why": "whenever a spell or ability causes its controller to shuffle — no shuffle trigger"
  },
  {
   "name": "Defend the Hearth",
   "needs": [
    "replacement:prevent-combat-damage-to-filter"
   ],
   "why": "prevent all combat damage dealt to players — prevent-all-combat-damage filters only the source"
  },
  {
   "name": "Psychic Intrusion",
   "needs": [
    "effect:choose-card-from-hand-or-graveyard"
   ],
   "why": "exile a nonland card from the opponent's hand or graveyard, cast it with mana of any colour"
  },
  {
   "name": "Unexpectedly Absent",
   "needs": [
    "effect:put-on-library-dynamic-position"
   ],
   "why": "put it into its owner's library just beneath the top X cards — put-on-library's fromTop is a fixed number"
  },
  {
   "name": "Naya Soulbeast",
   "needs": [
    "amount:cards-revealed-this-way"
   ],
   "why": "X is the total mana value of the cards revealed this way; cards left in the library count 0"
  },
  {
   "name": "Steam Augury",
   "needs": [
    "decision:separate-into-piles"
   ],
   "why": "an opponent separates the revealed cards into two piles, you choose one"
  },
  {
   "name": "Hundred-Handed One",
   "needs": [
    "static:block-additional-creature"
   ],
   "why": "while monstrous, can block any number of creatures — no static lets a creature block more than one"
  },
  {
   "name": "Viper's Kiss",
   "needs": [
    "static:attached-activated-abilities-prohibited"
   ],
   "why": "enchanted creature's activated abilities can't be activated — prohibits.abilitiesOf has no 'the attached creature' filter"
  },
  {
   "name": "True-Name Nemesis",
   "needs": [
    "effect:protection-from-player-for-permanent"
   ],
   "why": "choose a player as it enters; protection from the chosen player"
  },
  {
   "name": "Mystic Barrier",
   "needs": [
    "effect:rechoose-direction-each-upkeep",
    "static:attack-direction-restriction"
   ],
   "why": "direction re-chosen each upkeep; Pramikon's direction is chosen only as it enters"
  },
  {
   "name": "Curse of Predation",
   "needs": [
    "trigger:creature-attacks-enchanted-player"
   ],
   "why": "'whenever a creature attacks enchanted player' — attacks-player fires once per attacked player, not per creature"
  },
  {
   "name": "Marath, Will of the Wild",
   "needs": [
    "effect:modal-activated-targeted-modes"
   ],
   "why": "a modal activated ability whose modes have targets (and X counters removed as cost)"
  },
  {
   "name": "Sudden Demise",
   "needs": [
    "decision:choose-color-on-resolution",
    "filter:chosen-color"
   ],
   "why": "choose a colour as it resolves, then damage each creature of that colour an opponent controls"
  },
  {
   "name": "Fell Shepherd",
   "needs": [
    "filter:put-into-graveyard-from-battlefield-this-turn"
