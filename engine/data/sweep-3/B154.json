  "blocked": [
    {
      "name": "Talent of the Telepath",
      "needs": [
        "effect:cast-now-from-opponent-library-top"
      ],
      "why": "Cast an instant or sorcery from among the top seven of target opponent's library (up to two with spell mastery), the rest into their graveyard: cast-now's libraryTop reads only the caster's own library."
    },
    {
      "name": "Chandra, Fire of Kaladesh // Chandra, Roaring Flame",
      "needs": [
        "condition:single-source-dealt-n-damage-this-turn"
      ],
      "why": "'If Chandra has dealt 3 or more damage this turn, exile her, then return her transformed' — nothing counts the damage one source dealt this turn."
    },
    {
      "name": "Kytheon, Hero of Akros // Gideon, Battle-Forged",
      "needs": [
        "static:must-attack-planeswalker"
      ],
      "why": "Gideon's +2: 'up to one target creature an opponent controls attacks Gideon during its controller's next turn if able' — attack requirements can't name a planeswalker. Both faces blocked."
    },
    {
      "name": "Harbinger of the Tides",
      "needs": [
        "effect:flash-for-extra-cost"
      ],
      "why": "'You may cast this spell as though it had flash if you pay {2} more' — a kicker with flash would make it a kicked spell and offer the {2} at sorcery speed."
    },
    {
      "name": "The Great Aurora",
      "needs": [
        "effect:shuffle-hand-and-permanents-draw-that-many"
      ],
      "why": "Each player shuffles their hand and the permanents they own into their library and draws that many, then may put any number of lands from hand onto the battlefield."
    },
    {
      "name": "Orbs of Warding",
      "needs": [
        "replacement:prevent-n-of-damage"
      ],
      "why": "'If a creature would deal damage to you, prevent 1 of that damage' — a plus: -1 replacement isn't prevention (can't-be-prevented, ordering)."
    },
    {
      "name": "Embermaw Hellion",
      "needs": [
        "replacement:damage-plus-from-other-sources"
      ],
      "why": "'If another red source you control would deal damage, it deals that much +1' — the damage-plus replacement can't leave out the Hellion itself."
    },
    {
      "name": "Thornbow Archer",
      "needs": [
        "condition:that-player-controls"
      ],
      "why": "'Each opponent who doesn't control an Elf loses 1 life' — no per-player 'controls' condition inside for-each-player."
    },
    {
      "name": "Disciple of the Ring",
      "needs": [
        "effect:modal-activated-targeted-modes"
      ],
      "why": "A modal activated ability with targeted modes."
    },
    {
      "name": "Alhammarret, High Arbiter",
      "needs": [
        "decision:choose-card-name"
      ],
      "why": "Name a nonland card revealed from opponents' hands as it enters; spells with that name can't be cast."
    },
    {
      "name": "Exquisite Firecraft",
      "needs": [
        "static:self-uncounterable-if"
      ],
      "why": "Spell mastery's 'this spell can't be countered' — cantBeCountered is unconditional."
    },
    {
      "name": "Psychic Rebuttal",
      "needs": [
        "effect:copy-countered-spell"
      ],
      "why": "Spell mastery's 'you may copy the spell countered this way' — nothing copies the countered spell."
    },
    {
      "name": "Hallowed Moonlight",
      "needs": [
        "effect:temporary-enter-exile-replacement"
      ],
      "why": "Until end of turn, a creature that would enter and wasn't cast is exiled instead — no temporary enters-exiled replacement."
    },
    {
      "name": "Touch of Moonglove",
      "needs": [
        "trigger:dies-after-dealt-damage-by-source"
      ],
      "why": "'Whenever a creature dealt damage by that creature dies this turn, its controller loses 2 life' — damagedThisTurnBy can't name one specific object."
    },
    {
      "name": "Possessed Skaab",
      "needs": [
        "replacement:self-dies-exile-instead"
      ],
      "why": "'If this creature would die, exile it instead' — GraveyardExileReplacement.self is from anywhere, so a countered Skaab would be exiled too."
    },
    {
      "name": "Joraga Invocation",
      "needs": [
        "effect:restrict-each-matching-at-resolution"
      ],
      "why": "'Each creature you control … must be blocked this turn if able' covers only the creatures there as it resolves; a filtered restrict also catches later ones."
    },
    {
      "name": "Bonded Construct",
      "needs": [
        "static:cant-attack-alone"
      ],
      "why": "'Can't attack alone' has no vocabulary."
    },
    {
      "name": "Suppression Bonds",
      "needs": [
        "static:enchanted-abilities-cant-be-activated"
      ],
      "why": "'Its activated abilities can't be activated' — prohibits.abilitiesOf can't name the enchanted permanent."
    },
    {
      "name": "Swift Reckoning",
      "needs": [
        "effect:self-flash-if-condition"
      ],
      "why": "Spell mastery's 'you may cast this spell as though it had flash' — the only spell-level flash is kicker/behold's."
    },
    {
      "name": "Infinite Obliteration",
      "needs": [
        "decision:choose-card-name",
        "effect:extract-same-name"
      ],
      "why": "Choose a creature card name, then search target opponent's graveyard, hand and library for cards with that name and exile them."
    }
  ]
}
