 "blocked": [
  {
   "name": "Manaforge Cinder",
   "needs": [
    "cost:activate-no-more-than-n-times-each-turn"
   ],
   "why": "\"Activate no more than three times each turn\": activated abilities can be limited to once a turn only."
  },
  {
   "name": "Tower Above",
   "needs": [
    "effect:forced-block-this-combat"
   ],
   "why": "The granted attack trigger's \"target creature blocks it this turn if able\": nothing makes one creature block a particular attacker."
  },
  {
   "name": "Pale Wayfarer",
   "needs": [
    "effect:grant-protection-choice"
   ],
   "why": "Protection from the colour the target's controller chooses: no effect grants protection from a chosen colour."
  },
  {
   "name": "Hollowborn Barghest",
   "needs": [
    "condition:that-player-hand-size"
   ],
   "why": "The second trigger's \"if that player has no cards in hand\" reads the active opponent's hand; the hand-size condition reads only you or each player."
  },
  {
   "name": "Cragganwick Cremator",
   "needs": [
    "amount:this-way-total-power-of-cards"
   ],
   "why": "\"Damage equal to the discarded card's power\": a discarded card's power reads 0 once it's in the graveyard."
  },
  {
   "name": "Jaws of Stone",
   "needs": [
    "effect:divided-dynamic-total"
   ],
   "why": "Damage divided as you choose, X the Mountains you control as you cast it: a divided total is a number or the spell's X only."
  },
  {
   "name": "Strip Bare",
   "needs": [
    "filter:attached-to-target"
   ],
   "why": "\"Destroy all Auras and Equipment attached to target creature\": a filter's attachedTo takes a filter, not a target slot."
  },
  {
   "name": "Ember Gale",
   "needs": [
    "effect:restrict-all-target-player"
   ],
   "why": "\"Creatures target player controls can't block this turn\", binding creatures entering later: the filter restriction has no target-player controller."
  },
  {
   "name": "Valleymaker",
   "needs": [
    "effect:mana-ability-chosen-player-adds",
    "decision:choose-player"
   ],
   "why": "\"Choose a player. That player adds {G}{G}{G}\": a mana ability adding mana to a chosen player."
  },
  {
   "name": "Glamer Spinners",
   "needs": [
    "filter:attached-to-target",
    "effect:move-auras-to-chosen-permanent"
   ],
   "why": "Moves all Auras enchanting target permanent onto another permanent with the same controller chosen as it resolves."
  },
  {
   "name": "Worldpurge",
   "needs": [
    "effect:each-player-keeps-n-shuffles-rest",
    "effect:empty-mana-pool"
   ],
   "why": "Each player keeps up to seven cards and shuffles the rest of their hand in, then everyone loses unspent mana."
  },
  {
   "name": "Heartmender",
   "needs": [
    "effect:remove-counters-all"
   ],
   "why": "\"Remove a -1/-1 counter from each creature you control\": remove-counter reaches one permanent only."
  },
  {
   "name": "Illuminated Folio",
   "needs": [
    "cost:reveal-cards-sharing-color"
   ],
   "why": "Its cost reveals two cards from your hand that share a colour."
  },
  {
   "name": "Counterbore",
   "needs": [
    "effect:extract-same-name"
   ],
   "why": "Searches the spell controller's graveyard, hand and library for cards with the countered spell's name and exiles them."
  },
  {
   "name": "Gloomlance",
   "needs": [
    "effect:discard-controller-of-target"
   ],
   "why": "\"Its controller discards a card\" for a destroyed creature: discard reads only a player target slot."
  },
  {
   "name": "Fossil Find",
   "needs": [
    "effect:reorder-graveyard"
   ],
   "why": "\"Then reorder your graveyard as you choose\": the engine keeps no player-chosen graveyard order."
  },
  {
   "name": "Inquisitor's Snare",
   "needs": [
    "replacement:prevent-damage-by-target-this-turn"
   ],
   "why": "Prevents all damage the target attacking or blocking creature would deal this turn (even after it leaves, a ruling): prevent-damage shields a receiver only."
  },
  {
   "name": "Medicine Runner",
   "needs": [
    "effect:remove-counter-chosen-kind"
   ],
   "why": "\"Remove a counter from target permanent\" of any kind the player chooses: remove-counter names one fixed kind."
  },
  {
   "name": "Knollspine Invocation",
   "needs": [
    "cost:discard-mana-value-x"
   ],
   "why": "\"{X}, Discard a card with mana value X\": the discard cost's filter can't read the announced X."
  },
  {
   "name": "Whimwader",
   "needs": [
    "static:attack-restriction-defending-player-condition"
   ],
   "why": "\"Can't attack unless defending player controls a blue permanent\": no condition reads what the defending player controls."
  }
 ]
}
