  {
   "name": "Recommission",
   "needs": [
    "effect:enters-with-counters-if-type"
   ],
   "why": "\"If a creature enters this way, it enters with an additional +1/+1 counter\" is judged as it enters (a copy effect can make it a creature); a check of the graveyard card misses that."
  },
  {
   "name": "Hulking Metamorph",
   "needs": [
    "replacement:copy-on-enter-own-pt"
   ],
   "why": "The copy keeps this creature's own power and toughness (7/7, or 3/3 prototyped); CopyExceptions.basePt takes only fixed numbers."
  },
  {
   "name": "The Temporal Anchor",
   "needs": [
    "trigger:scry-bottom-count"
   ],
   "why": "\"Whenever you choose to put one or more cards on the bottom of your library while scrying, exile that many\": no trigger on the scry choice, nor its count."
  },
  {
   "name": "Tawnos, the Toymaker",
   "needs": [
    "effect:copy-spell-add-types"
   ],
   "why": "The spell copy is an artifact in addition to its other types; copy-spell takes no exceptions."
  },
  {
   "name": "Visions of Phyrexia",
   "needs": [
    "condition:played-card-from-exile-this-turn"
   ],
   "why": "\"If you didn't play a card from exile this turn\": no this-turn condition covers lands played from exile."
