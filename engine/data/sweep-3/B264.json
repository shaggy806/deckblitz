 "blocked": [
  {
   "name": "Infectious Rage",
   "needs": [
    "effect:random-permanent-it-can-enchant"
   ],
   "why": "A random choose-permanents can't limit itself to creatures the Aura can legally enchant."
  },
  {
   "name": "Emergent Ultimatum",
   "needs": [
    "effect:opponent-chooses-among-exiled-shuffle-in"
   ],
   "why": "search-library's instead sends the opponent's pick straight to the library; it's never exiled first."
  },
  {
   "name": "Akiri, Fearless Voyager",
   "needs": [
    "effect:unattached-from-creature-ref"
   ],
   "why": "Nothing names the creature the Equipment was unattached from, to tap it."
  },
  {
   "name": "Spider-Punk",
   "needs": [
    "static:spells-and-abilities-cant-be-countered"
   ],
   "why": "grantsToSpells.cantBeCountered covers spells, not abilities."
  },
  {
   "name": "Ral Zarek, Guest Lecturer",
   "needs": [
    "effect:flip-coins-count-until-lose"
   ],
   "why": "Flip five coins with the heads counted: flip-coin has no count."
  },
  {
   "name": "Ugin's Nexus",
   "needs": [
    "replacement:would-die-exile-and-extra-turn"
   ],
   "why": "'Instead exile it and take an extra turn after this one' has no shape."
  },
  {
   "name": "Chandra, Heart of Fire",
   "needs": [
    "effect:search-finds-castable-this-turn"
   ],
   "why": "The −9's finds may be cast this turn, later; the built key casts only during resolution."
  },
  {
   "name": "Ugin, Eye of the Storms",
   "needs": [
    "effect:search-finds-castable-this-turn"
   ],
   "why": "The −11's finds may be cast free this turn, later; the built key casts only during resolution."
  },
  {
   "name": "Decoy Gambit",
   "needs": [
    "effect:unless-per-target-held"
   ],
   "why": "Per-target unless answered in turn order, then all draws and returns together; for-each-unless can't run over targets."
  },
  {
   "name": "Thorin, Mountain-king",
   "needs": [
    "effect:this-way-attached"
   ],
   "why": "'When one or more Equipment become attached this way' needs a this-way record of attachments."
  },
  {
   "name": "Frontier Warmonger",
   "needs": [
    "trigger:attack-batch-per-defender-or-their-planeswalkers"
   ],
   "why": "attacks-player fires per attacked player, not for attacks on their planeswalkers."
  },
  {
   "name": "Dollmaker's Shop // Porcelain Gallery",
   "needs": [
    "static:set-base-pt-others-from-count"
   ],
   "why": "Porcelain Gallery sets other creatures' base P/T from a count; setBasePtFromCount works only on the card itself."
  },
  {
   "name": "Krovikan Vampire",
   "needs": [
    "effect:return-died-cards-dealt-damage-by-source"
   ],
   "why": "Nothing names the creatures it damaged this turn that died, to put them onto the battlefield."
  },
  {
   "name": "Azula, Cunning Usurper",
   "needs": [
    "zone:linked-exile-cast-as-though-flash"
   ],
   "why": "playFromExile has no flash option; castAsThoughFlash can't single out cards exiled with the source."
  },
  {
   "name": "Kheru Mind-Eater",
   "needs": [
