 "blocked": [
  {
   "name": "Pull from Eternity",
   "needs": [
    "target:card-in-exile",
    "effect:put-exiled-card-into-graveyard"
   ],
   "why": "No target slot picks a face-up card in exile."
  },
  {
   "name": "Curse of the Cabal",
   "needs": [
    "effect:add-time-counters-suspended-card"
   ],
   "why": "Its upkeep trigger works while suspended now (whileSuspended), but \"put two time counters on this card\" can't add counters to a suspended card in exile."
  },
  {
   "name": "Temporal Isolation",
   "needs": [
    "replacement:prevent-damage-dealt-by-enchanted"
   ],
   "why": "Preventing all damage the enchanted creature would deal: no damage replacement narrows its source to the Aura's creature."
  },
  {
   "name": "Pulmonic Sliver",
   "needs": [
    "replacement:graveyard-to-library-top-optional"
   ],
   "why": "All Slivers' optional \"put it on top of its owner's library instead\" replacement isn't expressible as a granted static."
  },
  {
   "name": "Serra Avenger",
   "needs": [
    "condition:own-turn-count"
   ],
   "why": "\"Can't cast during your first, second, or third turns\": nothing counts a player's turns."
  },
  {
   "name": "Fortune Thief",
   "needs": [
    "static:damage-life-floor"
   ],
   "why": "\"Damage that would reduce your life below 1 reduces it to 1 instead\" exists only as a one-shot effect."
  },
  {
   "name": "Thelon of Havenwood",
   "needs": [
    "cost:exile-from-any-graveyard"
   ],
   "why": "\"Exile a Fungus card from a graveyard\": the exile-from-graveyard cost reaches only your own."
  },
  {
   "name": "Truth or Tale",
   "needs": [
    "decision:separate-into-piles"
   ],
   "why": "Piles: one player separates, an opponent chooses."
  },
  {
   "name": "Jaya Ballard, Task Mage",
   "needs": [
    "effect:cant-be-regenerated-this-turn"
   ],
   "why": "\"A creature dealt damage this way can't be regenerated this turn\" on a damage sweep."
  },
  {
   "name": "Detainment Spell",
   "needs": [
    "filter:enchanted-by-source"
   ],
   "why": "Abilities of the creature this Aura enchants can't be activated: no filter names it."
  },
  {
   "name": "Conflagrate",
   "needs": [
    "cost:flashback-discard-cost"
   ],
   "why": "Flashback—{R}{R}, Discard X cards."
  },
  {
   "name": "Yavimaya Dryad",
   "needs": [
    "effect:search-put-under-target-player-control"
   ],
   "why": "The land found enters under a target player's control."
  },
  {
   "name": "Magus of the Mirror",
   "needs": [
    "effect:exchange-life-totals"
   ],
   "why": "Exchange life totals with target opponent."
  },
  {
   "name": "Jhoira's Timebug",
   "needs": [
    "target:permanent-or-suspended-card",
    "effect:remove-time-counters-chosen-suspended"
   ],
   "why": "Targets a permanent you control or a suspended card you own; add or remove a time counter, your choice."
  },
  {
   "name": "Brine Elemental",
   "needs": [
    "effect:skip-next-untap-step"
   ],
   "why": "Each opponent skips their next untap step."
  },
  {
   "name": "Sedge Sliver",
   "needs": [
    "static:grant-static-ability"
   ],
