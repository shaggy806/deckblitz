  "blocked": [
    {
      "name": "Soulfire Grand Master",
      "needs": [
        "effect:next-spell-returns-to-hand"
      ],
      "why": "\"The next instant or sorcery spell you cast from your hand this turn\" goes to your hand instead of the graveyard: exile-spell-as-it-resolves only exiles."
    },
    {
      "name": "Wardscale Dragon",
      "needs": [
        "static:defending-player-cant-cast"
      ],
      "why": "\"As long as it's attacking, defending player can't cast spells\": prohibits names only opponents, you or each player, and opponents is wrong in multiplayer (the ruling)."
    },
    {
      "name": "Wildcall",
      "needs": [
        "effect:manifested-this-way"
      ],
      "why": "manifest records nothing this-way, so the X +1/+1 counters have nothing to go on."
    },
    {
      "name": "Arashin War Beast",
      "needs": [
        "trigger:deals-combat-damage-once-per-event"
      ],
      "why": "\"Whenever it deals combat damage to one or more blocking creatures\": deals-damage fires once per recipient, so two blockers would trigger it twice."
    },
    {
      "name": "Friendly Fire",
      "needs": [
        "effect:random-card-from-hand"
      ],
      "why": "choose-random-card reads only a graveyard; the card reveals one at random from a creature's controller's hand."
    },
    {
      "name": "Hungering Yeti",
      "needs": [
        "effect:self-flash-if-condition"
      ],
      "why": "\"As long as you control a green or blue permanent, you may cast this spell as though it had flash\": castAsThoughFlash is a battlefield static only."
    },
    {
      "name": "Soulflayer",
      "needs": [
        "static:keywords-of-cards-delved"
      ],
      "why": "Nothing records which cards delve exiled, so it can't gain each listed keyword they had."
    },
    {
      "name": "Elite Scaleguard",
      "needs": [
        "effect:defending-player-of-trigger-attacker"
      ],
      "why": "\"Tap target creature defending player controls\" where the attacker is the trigger object, not the source: defendingPlayerOf reads the ability's source, wrong at 3-4 players."
    },
    {
      "name": "Ghastly Conscription",
      "needs": [
        "effect:manifest-from-exile"
      ],
      "why": "manifest takes only the top card of a library; this manifests a shuffled face-down pile exiled from a graveyard."
    },
    {
      "name": "Cloudform",
      "needs": [
        "effect:enchantment-becomes-aura"
      ],
      "why": "Nothing turns a non-Aura enchantment into an Aura with enchant creature to attach to the creature it manifested."
    },
    {
      "name": "Lightform",
      "needs": [
        "effect:enchantment-becomes-aura"
      ],
      "why": "As Cloudform."
    },
    {
      "name": "Rageform",
      "needs": [
        "effect:enchantment-becomes-aura"
      ],
      "why": "As Cloudform."
    },
    {
      "name": "Grim Contest",
      "needs": [
        "effect:fight-by-toughness"
      ],
      "why": "fight uses power; two damage steps wouldn't be simultaneous (wither/infect) nor follow the ruling that neither deals damage if a target is illegal."
    },
    {
      "name": "Warden of the First Tree",
      "needs": [
        "effect:set-creature-type"
      ],
      "why": "\"Becomes a Human Spirit Warrior with trample and lifelink\" replaces creature types without setting P/T: animate needs P/T and add-types only adds."
    },
    {
      "name": "Torrent Elemental",
      "needs": [
        "zone:activate-from-exile"
      ],
      "why": "An activated ability's zone can be hand, graveyard or command, not exile."
    },
    {
      "name": "Shifting Loyalties",
      "needs": [
        "effect:exchange-control",
        "effect:targets-share-type"
      ],
      "why": "No exchange-control effect, nor a two-targets-share-a-card-type requirement."
    },
    {
      "name": "Wild Slash",
      "needs": [
        "static:damage-cant-be-prevented"
      ],
      "why": "Ferocious's \"damage can't be prevented this turn\" has no effect in the engine."
    },
    {
      "name": "Channel Harm",
      "needs": [
        "replacement:prevent-and-reflect-damage"
      ],
      "why": "Prevent all damage sources you don't control would deal to you and your permanents this turn, then deal that much to target creature: not expressible."
    },
    {
      "name": "Formless Nurturing",
      "needs": [
        "effect:manifested-this-way"
      ],
      "why": "manifest records nothing this-way, so \"put a +1/+1 counter on it\" has nothing to point at."
    },
    {
      "name": "Jeskai Infiltrator",
      "needs": [
        "effect:manifest-exiled-pile"
      ],
      "why": "Exile it and the top card, shuffle them face down and manifest both: no such effect."
    }
  ]
}
