 "blocked": [
  {
   "name": "Territorial Gorger",
   "needs": [
    "trigger:energy-gained"
   ],
   "why": "No \"whenever you get one or more {E}\" trigger: get-energy fires nothing a trigger can watch."
  },
  {
   "name": "Ghirapur Guide",
   "needs": [
    "effect:cant-be-blocked-by-filter-until-eot"
   ],
   "why": "No effect gives one target \"can't be blocked by creatures with power 2 or less this turn\"; cantBeBlockedBy is static-only."
  },
  {
   "name": "Treacherous Terrain",
   "needs": [
    "amount:count-that-player-controls"
   ],
   "why": "countOf can't count \"lands that player controls\" per opponent inside a for-each-player."
  },
  {
   "name": "Manifold Insights",
   "needs": [
    "decision:opponent-chooses-card"
   ],
   "why": "Each opponent in turn picks a different nonland card from the revealed cards."
  },
  {
   "name": "Consulate Surveillance",
   "needs": [
    "replacement:prevent-damage-from-chosen-source"
   ],
   "why": "prevent-damage-from-chosen-source takes only next-time or a number, not all damage this turn."
  },
  {
   "name": "Midnight Oil",
   "needs": [
    "static:max-hand-size-equal-to-count"
   ],
   "why": "Maximum hand size equal to the number of hour counters on it."
  },
  {
   "name": "Disappearing Act",
   "needs": [
    "cost:return-permanent-additional-cost"
   ],
   "why": "additionalCost has no \"return a permanent you control to its owner's hand\"."
  },
  {
   "name": "Fairgrounds Trumpeter",
   "needs": [
    "condition:counters-put-by-you-this-turn"
   ],
   "why": "No turn stat records that a +1/+1 counter was put on a permanent you control this turn."
  },
  {
   "name": "Madcap Experiment",
   "needs": [
    "amount:cards-revealed-this-way"
   ],
   "why": "reveal-until doesn't expose how many cards it revealed."
  },
  {
   "name": "Die Young",
   "needs": [
    "cost:pay-any-amount-of-energy"
   ],
   "why": "Pay any amount of {E}, a per-energy effect."
  },
  {
   "name": "Trusty Companion",
   "needs": [
    "static:cant-attack-alone"
   ],
   "why": "No \"can't attack alone\" restriction."
