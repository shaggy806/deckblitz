 "blocked": [
  {
   "name": "Ambitious Augmenter",
   "needs": [
    "effect:put-counters-of-created"
   ],
   "why": "The dies trigger puts the creature's counters (every kind, as it last existed) on the Fractal token it just created: put-counters-of can't name a created token. Increment is built."
  },
  {
   "name": "Archaic's Agony",
   "needs": [
    "effect:excess-damage-amount"
   ],
   "why": "'Exile cards from the top of your library equal to the excess damage dealt to that creature this way' needs an amount for the excess damage a damage effect dealt (rule 120.4a); the converge damage and impulse-exile parts exist."
  },
  {
   "name": "Biblioplex Tomekeeper",
   "needs": [
    "effect:become-unprepared"
   ],
   "why": "The second mode, 'Target creature becomes unprepared', has no effect (only `become-prepared` exists)."
  },
  {
   "name": "Colossus of the Blood Age",
   "needs": [
    "decision:discard-any-number"
   ],
   "why": "The dies trigger's \"discard any number of cards, then draw that many cards plus one\" needs a discard-any-number choice (a real discard, counted for the draw); look-and-choose from hand has no discard destination."
  },
  {
   "name": "End of the Hunt",
   "needs": [
    "effect:each-opponent-exiles-choice"
   ],
   "why": "The target opponent chooses which of their tied greatest-mana-value creatures/planeswalkers to exile (the ruling); only `sacrifice` is a victim's-choice edict, and choose-permanents is always the effect controller's choice."
  },
  {
   "name": "Ennis, Debate Moderator",
   "needs": [
    "stat:cards-exiled-this-turn"
   ],
   "why": "\"If one or more cards were put into exile this turn\" counts cards put into exile from any zone by anyone (not tokens or prepare-spell copies, per the ruling); the only exile tally is turn-history `exiled`, which records permanents exiled from the battlefield under one player's control. The enters flicker itself is S.H.I.E.L.D. Flying Car's shape with an `other` optional target."
  },
  {
   "name": "Fractal Tender",
   "needs": [
    "condition:counters-put-by-you-this-turn"
   ],
   "why": "'If you put a counter on this creature this turn': nothing records the counters a player put on a permanent this turn. Increment is built."
  },
  {
   "name": "Group Project",
   "needs": [
    "cost:flashback-tap-creatures-cost"
   ],
   "why": "'Flashback—Tap three untapped creatures you control' needs a non-mana tap-creatures flashback cost; `flashback` only takes a mana cost, payLife, sacrifice or behold."
  },
  {
   "name": "Impractical Joke",
   "needs": [
    "static:damage-cant-be-prevented"
   ],
   "why": "\"Damage can't be prevented this turn\" — no effect turns off prevention (prevent-damage shields, Fog, protection) for the rest of the turn; the 3 damage half alone would drop a clause."
  },
  {
   "name": "Nita, Forum Conciliator",
   "needs": [
    "zone:impulse-exile-instead"
   ],
   "why": "The `exile` effect's `mayCast` (end-of-turn, spendAs any type) covers the exile-and-cast-this-turn part, but nothing can say 'If that spell would be put into a graveyard, exile it instead' for a spell cast under that permission."
  },
  {
   "name": "Practiced Scrollsmith",
   "needs": [
    "zone:exile-target-play-until-next-turn"
   ],
   "why": "\"Until the end of your next turn, you may cast that card\" for a card exiled from the graveyard by target: exile's mayCast has only end-of-turn and while-exiled durations (allow-cast-from-exile is this turn only)."
  },
  {
   "name": "Run Behind",
   "needs": [
    "decision:owner-chooses-top-or-bottom"
   ],
   "why": "\"Target creature's owner puts it on their choice of the top or bottom of their library\": the only way to hand the top/bottom choice to another player is each-player-may's `choices` with `who: { controllerOfTarget }`, which asks the controller, not the owner (wrong for a stolen creature); no PlayerScope names a target's owner. The cost reduction (targetCostReduction attacking) is fine."
  },
  {
   "name": "Soaring Stoneglider",
   "needs": [
    "cost:exile-from-graveyard-additional"
   ],
   "why": "'Exile two cards from your graveyard or pay {1}{W}' needs an exile-from-graveyard branch in AdditionalCostOption (it has sacrifice/discard/payLife/mana/blight/behold only; exileFromGraveyard exists only on ability costs)."
  },
  {
   "name": "Suspend Aggression",
   "needs": [
    "zone:exile-owner-may-play"
   ],
   "why": "The targeted nonland permanent's owner (often an opponent) may play it until the end of THEIR next turn: exile's mayCast is the effect controller's only, cast-only, and end-of-turn/while-exiled; the library half alone would be impulse-exile duration your-next-turn."
  },
  {
   "name": "Tester of the Tangential",
   "needs": [
    "effect:move-counter"
   ],
   "why": "'You may pay {X}. When you do, move X +1/+1 counters': move-counters has no X amount and no pay-X reflexive shape. Increment is built."
  },
  {
   "name": "Wilt in the Heat",
   "needs": [
    "replacement:target-exile-if-dies-this-turn"
   ],
   "why": "'If that creature would die this turn, exile it instead' needs a turn-long dies-only exile replacement on the targeted creature (exileIfItWouldLeave catches every leave, not just dying); the cost reduction is expressible (selfCostReduction on turn-stat cards-left-graveyard)."
  }
 ]
}
