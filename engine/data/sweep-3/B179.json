  },
  {
   "name": "Civic Saber",
   "needs": [
    "static:grant-pt-per-own-colors"
   ],
   "why": "+1/+0 for each of the equipped creature's own colors — a static's per-count bonus can't count them"
  },
  {
   "name": "Avenging Arrow",
   "needs": [
    "condition:filter-dealt-damage-this-turn"
   ],
   "why": "'a creature that dealt damage this turn' (to anything) has no filter"
  },
  {
   "name": "Loxodon Smiter",
   "needs": [
    "replacement:discarded-by-opponent-to-battlefield"
   ],
   "why": "discarded by an opponent's spell or ability: onto the battlefield instead"
  },
  {
   "name": "Street Sweeper",
   "needs": [
    "filter:attached-to-target"
   ],
   "why": "destroy all Auras attached to target land"
  },
  {
   "name": "Psychic Spiral",
   "needs": [
    "amount:cards-shuffled-this-way"
   ],
   "why": "mills as many cards as were just shuffled into the library"
  },
  {
   "name": "Rakdos's Return",
   "needs": [
    "effect:discard-controller-of-target"
   ],
