  },
  {
   "name": "Chemister's Trick",
   "needs": [
    "effect:restrict-each-matching-at-resolution"
   ],
   "why": "overloaded 'attacks this turn if able' binds only the creatures there as it resolves"
  },
  {
   "name": "Shrieking Affliction",
   "needs": [
    "condition:that-player-hand-size"
   ],
   "why": "intervening-if on the hand of the opponent whose upkeep it is"
  },
  {
   "name": "Guild Feud",
   "needs": [
    "effect:reveal-opponent-library-put-onto-battlefield",
