 "blocked": [
  {
   "name": "Avatar Destiny",
   "needs": [
    "bug:simultaneous-zone-moves"
   ],
   "why": "\"Return this card to its owner's hand and up to one creature card milled this way to the battlefield\" is one instruction (both leave the graveyard as one event), but the creature pick is a look-and-choose decision, which a simultaneous sequence can't hold, so it would be two graveyard-leave events (a 'one or more cards leave your graveyard' trigger such as Teval's would fire twice)."
  },
  {
   "name": "Bumi, King of Three Trials",
   "needs": [
    "effect:target-player-scries"
   ],
   "why": "Mode \"Target player scries 3\": `scry` has no target slot or player scope, only the effect's controller (the up-to-X modal with X = Lesson cards in your graveyard is expressible via maxModes countInGraveyard)."
  },
  {
   "name": "Diligent Zookeeper",
   "needs": [
    "static:pt-per-affected-creature-types"
   ],
   "why": "\"Each non-Human creature you control gets +1/+1 for each of its creature types, to a maximum of 10\" needs grantPtPerCount over the affected creature's own creature-type count, capped; nothing counts subtypes."
  },
  {
   "name": "Fatal Fissure",
   "needs": [
    "effect:delayed-trigger-own-targets"
   ],
   "why": "\"When that creature dies this turn, you earthbend 4\" is a delayed trigger whose earthbend targets a land chosen as the delayed trigger goes on the stack (rule 603.7c); a delayed-trigger effect can only reuse the creating spell's targets, and a reflexive trigger inside it would add a stack object the card doesn't have."
  },
  {
   "name": "Koh, the Face Stealer",
   "needs": [
    "static:has-abilities-of-chosen-exiled-card"
   ],
   "why": "\"Pay 1 life: Choose a creature card exiled with Koh\" plus \"Koh has all activated and triggered abilities of the last chosen card\" needs a remembered choice among linked-exiled cards and a static granting that card's activated and triggered abilities; only grantsActivatedOfLinkedExile (activated abilities of every linked card) exists."
  },
  {
   "name": "Lost Days",
   "needs": [
    "decision:owner-chooses-top-or-bottom"
   ],
   "why": "The target's OWNER chooses second from the top or the bottom of their library (the ruling); put-on-library has a fixed position, and no chooser shape reaches the owner (each-player-may/unless only reach a target's controller, which differs for a stolen permanent)."
  },
  {
   "name": "Path to Redemption",
   "needs": [
    "effect:effect-on-enchanted-permanent"
   ],
   "why": "\"{5}, Sacrifice this Aura: Exile enchanted creature\": no EffectTargetRef names the Aura's enchanted creature (as last attached once the Aura is sacrificed as a cost)."
  },
  {
   "name": "Razor Rings",
   "needs": [
    "effect:excess-damage-amount"
   ],
   "why": "\"You gain life equal to the excess damage dealt this way\" needs an EffectAmount for the excess damage of a damage step; only excessToController and the excessDamageThisTurn filter exist."
  },
  {
   "name": "Serpent of the Pass",
   "needs": [
    "effect:self-flash-if-condition"
   ],
   "why": "\"If there are three or more Lesson cards in your graveyard, you may cast this spell as though it had flash\" printed on the spell itself has no vocabulary (castAsThoughFlash is a battlefield static); the cost reduction (selfCostReduction cardsInGraveyard) is expressible."
  },
  {
   "name": "Sokka, Bold Boomeranger",
   "needs": [
    "decision:discard-any-number"
   ],
   "why": "\"Discard up to two cards, then draw that many cards\": `discard` takes a fixed amount; there is no real discard of a player-chosen 0..N cards (two may-discard-one steps would make two discard events)."
  },
  {
   "name": "Trusty Boomerang",
   "needs": [
    "effect:granted-activated-refers-to-granter"
   ],
   "why": "The granted ability \"{1}, {T}: Tap target creature. Return Trusty Boomerang to its owner's hand\" runs on the equipped creature, and a grantsActivated ability's effect has no way to name the Equipment that granted it (its \"source\" is the creature)."
  },
  {
   "name": "Turtle-Duck",
   "needs": [
    "effect:set-base-power-only"
   ],
   "why": "\"Has base power 4\" until end of turn sets only base power in layer 7b; animate always sets both base power and toughness, and writing the toughness back as a number is wrong under another toughness-setting effect."
  },
  {
   "name": "Zhao, the Moon Slayer",
   "needs": [
    "static:nonbasic-lands-are-type"
   ],
   "why": "\"As long as Zhao has a conqueror counter on him, nonbasic lands are Mountains\" is a Blood Moon effect (set land subtype and strip the lands' other abilities, rule 305.7); a static has setSubtypes but no way to remove the lands' abilities."
  },
  {
   "name": "Zuko, Conflicted",
   "needs": [
    "effect:flicker-generalized",
    "effect:enters-under-opponent-control"
   ],
   "why": "Mode 4 \"Exile Zuko, then return him to the battlefield under an opponent's control\": flicker can't return under an opponent's control, and the exile + choose-opponent + put-onto-battlefield workaround can't tell the original Zuko from a new object (flickered in response it would give the new Zuko away; only flicker checks the source's timestamp, and a conditional's source-zone/source-on-battlefield don't)."
  }
 ]
}
