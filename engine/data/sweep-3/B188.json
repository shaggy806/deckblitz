  {
   "name": "Jar of Eyeballs",
   "needs": [
    "cost:remove-all-counters"
   ],
   "why": "\"{3}, {T}, Remove all eyeball counters: look at the top X cards, where X is the number removed\" — a cost removing all counters, X their count."
  },
  {
   "name": "Nevermore",
   "needs": [
    "decision:choose-card-name"
   ],
   "why": "\"As this enters, choose a nonland card name. Spells with the chosen name can't be cast.\""
  },
  {
   "name": "Gruesome Discovery",
   "needs": [
    "effect:discard-chosen-count"
   ],
   "why": "Morbid: \"you look at their hand and choose two cards from it\" — discard-chosen picks only one."
  },
  {
   "name": "Curse of the Nightly Hunt",
   "needs": [
    "static:static-over-enchanted-player"
   ],
   "why": "\"Creatures enchanted player controls attack each combat if able\": no static scope names the enchanted player's creatures."
  },
  {
   "name": "Caravan Vigil",
   "needs": [
    "effect:search-destination-choice"
   ],
   "why": "Morbid: the found land goes onto the battlefield instead of into hand, chosen after the search."
  },
  {
   "name": "Mirror-Mad Phantasm",
   "needs": [
    "effect:reveal-until-source-owners-library"
   ],
   "why": "\"its owner shuffles it into their library. If that player does, they reveal cards … until a card named Mirror-Mad Phantasm\": reveal-until can't name the source's owner (the rulings: the owner's library when someone else controls it)."
  },
  {
   "name": "Skaab Ruinator",
   "needs": [
    "cost:exile-from-graveyard-additional"
   ],
   "why": "A spell's additional cost of exiling three creature cards from your graveyard."
  },
  {
   "name": "Relentless Skaabs",
   "needs": [
    "cost:exile-from-graveyard-additional"
   ],
   "why": "A spell's additional cost of exiling a creature card from your graveyard."
  },
  {
   "name": "Headless Skaab",
   "needs": [
    "cost:exile-from-graveyard-additional"
   ],
   "why": "A spell's additional cost of exiling a creature card from your graveyard."
  },
  {
   "name": "Gutter Grime",
   "needs": [
    "static:token-pt-from-creator-counters"
   ],
   "why": "Its Ooze tokens' P/T is the number of slime counters on the Gutter Grime that made each one (the ruling)."
  },
  {
   "name": "Memory's Journey",
   "needs": [
    "effect:shuffle-graveyard-targets-into-library"
   ],
   "why": "\"Target player shuffles up to three target cards from their graveyard into their library\": a card slot bound to the targeted player's graveyard, and that player shuffles even with no cards targeted."
  },
  {
   "name": "Witchbane Orb",
   "needs": [
    "filter:attached-to-player"
   ],
   "why": "\"When this enters, destroy all Curses attached to you\": no filter selects Auras attached to a player (its hexproof half alone would drop a clause)."
  },
  {
   "name": "Cellar Door",
   "needs": [
    "effect:mill-from-bottom"
   ],
   "why": "Puts the bottom card of target player's library into their graveyard."
  },
  {
   "name": "Curse of Death's Hold",
   "needs": [
    "static:static-over-enchanted-player"
   ],
   "why": "\"Creatures enchanted player controls get -1/-1\": no static scope names the enchanted player's creatures."
  },
  {
   "name": "Sever the Bloodline",
   "needs": [
    "condition:same-name-as-target"
   ],
   "why": "\"Exile target creature and all other creatures with the same name as that creature.\""
  },
  {
   "name": "Altar of the Lost",
   "needs": [
    "cost:mana-restriction-cast-from-graveyard",
    "condition:filter-has-flashback"
   ],
   "why": "Mana spendable only on spells with flashback cast from a graveyard (any graveyard, the rulings)."
  },
  {
   "name": "Bitterheart Witch",
   "needs": [
    "effect:put-onto-battlefield-attached"
   ],
   "why": "Search for a Curse and put it onto the battlefield attached to target player."
  },
  {
   "name": "Curse of Stalked Prey",
   "needs": [
    "trigger:combat-damage-to-enchanted-player"
   ],
   "why": "\"Whenever a creature deals combat damage to enchanted player\": the damaged player can't be narrowed to the enchanted one."
  },
  {
   "name": "Dearly Departed",
   "needs": [
    "zone:graveyard-static"
   ],
   "why": "\"As long as this is in your graveyard, each Human creature you control enters with an additional +1/+1 counter\": a replacement from the graveyard."
  },
  {
   "name": "Runic Repetition",
   "needs": [
    "target:card-in-exile",
    "condition:filter-has-flashback"
   ],
   "why": "\"Return target exiled card with flashback you own to your hand.\""
  },
  {
   "name": "Curse of the Pierced Heart",
   "needs": [
    "effect:damage-player-or-their-planeswalker-choice"
   ],
   "why": "\"Deals 1 damage to that player or a planeswalker that player controls\": untargeted, the choice of the player or one of their planeswalkers made as it resolves. Its trigger (enchanted player's upkeep) is built."
  }
 ]
