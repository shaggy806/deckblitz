  "blocked": [
    {
      "name": "Rakdos Riteknife",
      "needs": [
        "effect:granted-activated-refers-to-granter"
      ],
      "why": "The ability it grants the equipped creature puts a blood counter on the Riteknife that granted it; a granted ability can only refer to the creature it's on."
    },
    {
      "name": "Aetheric Amplifier",
      "needs": [
        "effect:double-player-counters"
      ],
      "why": "\"Double the number of each kind of counter you have\": double-counters only works on a permanent."
    },
    {
      "name": "Lobelia, Defender of Bag End",
      "needs": [
        "effect:exile-top-face-down-linked",
        "zone:exiled-with-source-play"
      ],
      "why": "Exiling each opponent's top card face down, linked to Lobelia, then playing one of them free: neither the face-down linked exile nor the pick among cards exiled with it exists."
    },
    {
      "name": "Hierophant Bio-Titan",
      "needs": [
        "cost:spell-additional-cost-remove-counters"
      ],
      "why": "Removing any number of +1/+1 counters from among your creatures as a spell's optional additional cost, {2} less each: only abilities' costs remove chosen counters."
    },
    {
      "name": "Scholar of New Horizons",
      "needs": [
        "effect:search-destination-choice"
      ],
      "why": "The found Plains goes onto the battlefield tapped or into the hand, chosen after the search (its ruling)."
    },
    {
      "name": "Feast of Worms",
      "needs": [
        "effect:sacrifice-controller-of-target"
      ],
      "why": "\"Its controller sacrifices another land\": sacrifice's who can't name the target's controller, nor leave out the target."
    },
    {
      "name": "Nahiri's Lithoforming",
      "needs": [
        "amount:additional-land-drop-amount",
        "effect:temporary-permanents-enter-tapped"
      ],
      "why": "\"You may play X additional lands this turn\" (a fixed amount only) and \"lands you control enter tapped this turn\"; the sacrifice-and-draw half works now."
    },
    {
      "name": "Omarthis, Ghostfire Initiate",
      "needs": [
        "trigger:counters-put-other"
      ],
      "why": "\"Whenever you put one or more +1/+1 counters on another colorless creature\": counters-put has no otherOnly, and Omarthis is colorless itself. The manifest count works now."
    },
    {
      "name": "Gluttonous Hellkite",
      "needs": [
        "replacement:enters-with-counters-per-cast-trigger-sacrifice"
      ],
      "why": "\"Enters with two +1/+1 counters for each creature sacrificed this way\" needs its cast trigger's sacrifice count carried to its enters replacement."
    },
    {
      "name": "Xavier Sal, Infested Captain",
      "needs": [
        "decision:choose-permanent"
      ],
      "why": "Its counter cost works now; populate's choice of a token (or its other key) is still open."
    },
    {
      "name": "Tekuthal, Inquiry Dominus",
      "needs": [
        "replacement:proliferate-replacement"
      ],
      "why": "Its counter cost works now; \"if you would proliferate, proliferate twice instead\" is still open."
    },
    {
      "name": "Quilled Greatwurm",
      "needs": [
        "zone:cast-self-from-graveyard"
      ],
      "why": "Casting it from the graveyard by removing six counters is still open."
    },
    {
      "name": "Dawnhand Dissident",
      "needs": [
        "zone:exiled-with-source-play"
      ],
      "why": "Casting creature spells exiled with it by removing counters is still open."
    },
