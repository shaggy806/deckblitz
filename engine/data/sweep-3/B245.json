  "blocked": [
    {
      "name": "Agility Bobblehead",
      "needs": [
        "effect:grant-cant-be-blocked-except"
      ],
      "why": "Its group's count is built, but no one-shot effect gives a target \"can't be blocked this turn except by creatures with haste\" (cantBeBlockedBy is a static only)."
    },
    {
      "name": "Rampaging War Mammoth",
      "needs": [
        "cost:cycling-x"
      ],
      "why": "Cycling {X}{2}{R}: the cycling cost has no X, and the \"when you cycle this card\" trigger can't read one."
    },
    {
      "name": "Glissa's Retriever",
      "needs": [
        "effect:opponents-with-poison-count"
      ],
      "why": "\"Up to X target cards, where X is the number of opponents who have three or more poison counters\": nothing counts players by a poison-counter test."
    },
    {
      "name": "The War in Heaven",
      "needs": [
        "effect:enter-as-additional-card-type"
      ],
      "why": "Chapter III's \"They're artifacts in addition to their other types\" must hold as they enter; put-onto-battlefield adds no card type."
    },
    {
      "name": "Comet Storm",
      "needs": [
        "decision:spell-target-count-amount"
      ],
      "why": "A spell's target count of one plus the times it was kicked: only an ability's group reads an amount."
    },
    {
      "name": "Midnight Arsonist",
      "needs": [
        "filter:without-mana-abilities"
      ],
      "why": "Its \"up to X, the number of Vampires you control\" is built; no filter reads \"without mana abilities\"."
    },
    {
      "name": "Filigree Vector",
      "needs": [
        "decision:two-any-number-groups"
      ],
      "why": "Two any-number groups in one list (creatures, then artifacts): a list holds one, last."
    },
    {
      "name": "Erebos's Intervention",
      "needs": [
        "decision:twice-x-target-count"
      ],
      "why": "\"Up to twice X target cards\" on a spell: a spell's group bound is a number or X."
    },
    {
      "name": "Angel of Serenity",
      "needs": [
        "decision:mixed-zone-targets"
      ],
      "why": "One group over battlefield creatures and graveyard creature cards together."
    },
    {
      "name": "Taskmaster, Mercenary Mimic",
      "needs": [
        "decision:mixed-zone-targets"
      ],
      "why": "\"Up to one target creature on the battlefield or creature card in a graveyard\": one slot over two zones."
    },
    {
      "name": "Endless Detour",
      "needs": [
        "decision:mixed-zone-targets"
      ],
      "why": "A spell, nonland permanent or graveyard card in one slot."
    },
    {
      "name": "Savior of Ollenbock",
      "needs": [
        "decision:mixed-zone-targets"
      ],
      "why": "A creature on the battlefield or a creature card in a graveyard in one slot."
    },
    {
      "name": "The Wise Mothman",
      "needs": [
        "trigger:trigger-mills-nonland-card"
      ],
      "why": "\"Whenever one or more nonland cards are milled\" has no trigger; its \"up to X\" (the number milled) would be the trigger value."
    },
    {
      "name": "The Rise of Sozin // Fire Lord Sozin",
      "needs": [
        "decision:choose-card-name"
      ],
      "why": "Chapter II names a card; Fire Lord Sozin's total mana value X targets are built."
    },
    {
      "name": "Fatal Lore",
      "needs": [
        "decision:opponent-chooses-mode"
      ],
      "why": "An opponent chooses the mode."
    },
    {
