  {
   "name": "Quillspike",
   "needs": [
    "cost:remove-counters-from-chosen"
   ],
   "why": "'Remove a -1/-1 counter from a creature you control' as a cost — removeCounter only takes counters from the source"
  },
  {
   "name": "Merrow Bonegnawer",
   "needs": [
    "effect:target-player-exiles-from-graveyard"
   ],
   "why": "'target player exiles a card from their graveyard' — the player's own choice of a graveyard card can't be aimed at a target slot"
  },
  {
   "name": "Endure",
   "needs": [
    "replacement:prevent-damage-to-you-and-your-other-permanents"
   ],
   "why": "'prevent all damage that would be dealt to you and permanents you control this turn' — no one-shot prevention over a player and their permanents"
  },
  {
   "name": "Desecrator Hag",
   "needs": [
    "condition:greatest-power-condition"
   ],
   "why": "'return the creature card in your graveyard with the greatest power' — untargeted, ties chosen; nothing picks it"
  },
  {
   "name": "Evershrike",
   "needs": [
    "amount:auras-attached-to-self",
    "effect:aura-returns-attached"
   ],
   "why": "+2/+2 per Aura attached to it, and putting an Aura from hand onto the battlefield attached to it (else exile it)"
  },
  {
   "name": "Fiery Bombardment",
   "needs": [
    "amount:chroma-of-cards"
   ],
   "why": "chroma of the sacrificed creature's mana cost — not devotion"
  },
  {
   "name": "Hallowed Burial",
   "needs": [
    "effect:put-on-bottom-of-library-all"
   ],
   "why": "'put all creatures on the bottom of their owners' libraries' — no mass bottom-of-library move"
  },
