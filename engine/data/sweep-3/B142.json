 "blocked": [
  {
   "name": "Illusion of Choice",
   "needs": [
    "effect:choose-how-each-player-votes"
   ],
   "why": "Nothing lets one player cast every player's votes for the turn."
  },
  {
   "name": "Custodi Lich",
   "needs": [
    "trigger:becomes-monarch"
   ],
   "why": "No \"whenever you become the monarch\" trigger."
  },
  {
   "name": "Knights of the Black Rose",
   "needs": [
    "trigger:becomes-monarch",
    "condition:was-monarch-as-turn-began"
   ],
   "why": "No trigger on an opponent becoming the monarch, and nothing records who was the monarch as the turn began."
  },
  {
   "name": "Collective Defiance",
   "needs": [
    "effect:discard-hand-target-player"
   ],
   "why": "Escalate is fine (costPerExtraMode), but discard-hand takes only a player scope, not a target: \"target player discards all the cards in their hand, then draws that many\"."
  },
  {
   "name": "Elder Deep-Fiend",
   "needs": [
    "keyword:emerge"
   ],
   "why": "Emerge isn't in the engine."
  },
  {
   "name": "Summary Dismissal",
   "needs": [
    "effect:counter-all-spells",
    "effect:counter-all-abilities"
   ],
   "why": "No effect exiles every other spell on the stack or counters every ability."
  },
  {
   "name": "Capital Punishment",
   "needs": [
    "effect:sacrifice-amount"
   ],
   "why": "Each opponent sacrifices a creature per death vote at once; sacrifice's count is a fixed number, and N separate sacrifices aren't simultaneous."
  },
  {
   "name": "Sanctum Prelate",
   "needs": [
    "static:cant-cast-chosen-mana-value-with-x"
   ],
   "why": "The choice is any number, and a mana-value prohibition is matched against the card before X is announced, so an X spell would be barred at every X."
  },
  {
   "name": "Daretti, Ingenious Iconoclast",
   "needs": [
    "target:artifact-card-in-graveyard-or-on-battlefield"
   ],
   "why": "The -6 needs one target slot that is a graveyard card or a permanent."
  },
  {
   "name": "Protector of the Crown",
   "needs": [
    "replacement:damage-redirection"
   ],
   "why": "Redirecting damage dealt to you to a creature isn't supported."
  },
  {
   "name": "Entourage of Trest",
   "needs": [
    "static:block-additional-creature"
   ],
   "why": "No \"can block an additional creature\" static."
  },
  {
   "name": "Spy Kit",
   "needs": [
    "static:has-all-nonlegendary-creature-names"
   ],
   "why": "An object can't have more than one name."
  },
  {
   "name": "Deadly Designs",
   "needs": [
    "cost:any-player-may-activate"
   ],
   "why": "No \"any player may activate this ability\" (only the opponents-only form)."
  },
  {
   "name": "Canal Courier",
   "needs": [
    "trigger:attacks-with-another-at-different-player"
   ],
   "why": "No trigger for \"this creature and another creature attack different players\"."
  },
  {
   "name": "Crown-Hunter Hireling",
   "needs": [
    "static:attack-restriction-defending-player-condition"
   ],
   "why": "\"Can't attack unless defending player is the monarch.\""
  },
  {
   "name": "Mirrorwing Dragon",
   "needs": [
    "effect:copy-spell-for-other-player"
   ],
   "why": "The copies are the caster's, for each other creature the caster controls the spell could target; forEachItCouldTarget reads the Dragon controller's side and can't hand the copies to the caster."
  }
 ]
}
