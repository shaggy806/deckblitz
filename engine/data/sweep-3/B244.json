  "blocked": [
    {
      "name": "Prismatic Boon",
      "needs": [
        "decision:x-targets"
      ],
      "why": "\"X target creatures gain protection from the chosen color\": a target count of X isn't built."
    },
    {
      "name": "Courageous Resolve",
      "needs": [
        "keyword:protection-from-opponents"
      ],
      "why": "Protection from each of your opponents is protection from players (rule 702.16k: what they control, and what they own that nobody else controls), not a filter."
    },
    {
      "name": "Crown of Awe",
      "needs": [
        "filter:shares-creature-type-with-attached"
      ],
      "why": "Its sacrifice ability reaches \"other creatures that share a creature type with it\": no filter for sharing a creature type with the enchanted creature."
    },
    {
      "name": "Concerted Effort",
      "needs": [
        "effect:share-protection-and-landwalk"
      ],
      "why": "Shares each creature's protection qualities and landwalk with the others: nothing copies one creature's protection to another."
    },
    {
      "name": "Earnest Fellowship",
      "needs": [
        "static:protection-from-own-colors"
      ],
      "why": "Each creature's protection follows its own colours: a static's protection is fixed, not read per affected object."
    },
    {
      "name": "Escaped Shapeshifter",
      "needs": [
        "filter:has-protection-from-color"
      ],
      "why": "Protection from any color an opponent's creature has protection from: no filter or count reads a creature's protection."
    },
    {
      "name": "Sanctuary Blade",
      "needs": [
        "decision:choose-color-on-attach"
      ],
      "why": "\"As this Equipment becomes attached to a creature, choose a color … protection from the last chosen color\": a choice made on each attachment, not as it enters."
    },
    {
      "name": "Eight-and-a-Half-Tails",
      "needs": [
        "effect:spell-color-change-carries-to-permanent"
      ],
      "why": "\"Target spell or permanent becomes white until end of turn\": a permanent spell made white stays white as the permanent it becomes (its ruling), but a spell's colour modifier is cleared as it moves to the battlefield."
    },
    {
      "name": "Devoted Caretaker",
      "needs": [
        "filter:protection-from-spells-only"
      ],
      "why": "\"Protection from instant spells and from sorcery spells\": no filter tells a spell on the stack from an instant or sorcery card elsewhere."
    },
    {
      "name": "Council Guardian",
      "needs": [
        "condition:vote-option-most-or-tied"
      ],
      "why": "\"Each color with the most votes or tied for most votes\": named-option votes have no most-or-tied follow-up (`for-each-voted \"most\"` covers players and permanents; `vote-won` is strictly most)."
    }
  ]
}
