  "blocked": [
    {
      "name": "Flowering Lumberknot",
      "needs": [
        "condition:paired-with-soulbond-creature"
      ],
      "why": "\"Unless it's paired with a creature with soulbond\": soulbond isn't a Keyword, so no filter reads whether the partner has it."
    },
    {
      "name": "Joint Assault",
      "needs": [
        "effect:paired-creature-of-target"
      ],
      "why": "\"If it's paired with a creature, that creature also gets +2/+2\": no effect target reads the creature a target is paired with."
    },
    {
      "name": "Chalice of Life // Chalice of Death",
      "needs": [
        "condition:life-above-starting"
      ],
      "why": "The life-total condition takes fixed numbers; \"10 life more than your starting life total\" can't be said."
    },
    {
      "name": "Elbrus, the Binding Blade // Withengar Unbound",
      "needs": [
        "trigger:player-loses-game-trigger"
      ],
      "why": "No trigger fires when a player loses the game."
    },
    {
      "name": "Fiend of the Shadows",
      "needs": [
        "zone:exile-player-hand-play-exiled"
      ],
      "why": "Playing (lands included) a card another player exiled from their hand, for as long as it stays exiled."
    },
    {
      "name": "Aggravate",
      "needs": [
        "effect:damage-dealt-this-way"
      ],
      "why": "\"Each creature dealt damage this way blocks this turn if able\" needs a dealt-damage-this-way filter on a mass restriction."
    },
    {
      "name": "Immerwolf",
      "needs": [
        "static:cant-transform"
      ],
      "why": "Nothing can say \"non-Human Werewolves you control can't transform\"."
    },
    {
      "name": "Curse of Echoes",
      "needs": [
        "trigger:enchanted-player-casts",
        "effect:copy-spell-for-other-player"
      ],
      "why": "No \"whenever enchanted player casts\" trigger, nor copies for each other player."
    },
    {
      "name": "Counterlash",
      "needs": [
        "filter:shares-card-type-with-target"
      ],
      "why": "\"A spell that shares a card type with it\" — sharesCardTypeWith reads only a sacrificed or trigger object."
    },
    {
      "name": "Alpha Brawl",
      "needs": [
        "effect:each-creature-deals-power-damage-to-target"
      ],
      "why": "Each creature dealt damage then deals damage equal to its power to that creature, each its own source."
    },
    {
      "name": "Descent into Madness",
      "needs": [
        "effect:each-player-exiles-permanents-or-hand-cards"
      ],
      "why": "Each player picks X among their permanents and hand cards together, all exiled at once."
    },
    {
      "name": "Predator's Gambit",
      "needs": [
        "condition:enchanted-controller-controls-no-other-creatures"
      ],
      "why": "\"If its controller controls no non-Human creatures\" reads the enchanted creature's controller, not the Aura's."
    },
    {
      "name": "Moonlight Geist",
      "needs": [
        "effect:prevent-combat-damage-to-and-by-source"
      ],
      "why": "Preventing combat damage dealt by this one object until end of turn."
    },
    {
      "name": "Curse of Misfortunes",
      "needs": [
        "effect:curse-attach-player",
        "mechanic:curses"
      ],
      "why": "Searching for a Curse and putting it onto the battlefield attached to a player, with a not-same-name filter over the Curses on that player."
    },
    {
      "name": "Curse of Thirst",
      "needs": [
        "trigger:enchanted-player-step-begins",
        "amount:curses-attached-to-player"
      ],
      "why": "\"At the beginning of enchanted player's upkeep\" and a count of the Curses attached to them."
    },
    {
      "name": "Appetite for Brains",
      "needs": [
        "effect:exile-chosen-from-revealed-hand"
      ],
      "why": "Choosing a card from an opponent's revealed hand to exile."
    },
    {
      "name": "Second Guess",
      "needs": [
        "condition:was-nth-spell-cast-this-turn"
      ],
      "why": "\"Counter target spell that's the second spell cast this turn.\""
    },
    {
      "name": "Midvast Protector",
      "needs": [
        "effect:grant-protection-choice"
      ],
      "why": "\"Gains protection from the color of your choice until end of turn.\""
    },
    {
      "name": "Huntmaster of the Fells // Ravager of the Fells",
      "needs": [
        "target:controlled-by-target-player"
      ],
      "why": "Ravager's second target is limited by the first's player."
    },
    {
      "name": "Curse of Exhaustion",
      "needs": [
        "static:static-over-enchanted-player"
      ],
      "why": "A prohibition that names the enchanted player."
    },
    {
      "name": "Call to the Kindred",
      "needs": [
        "filter:shares-creature-type-with-attached"
      ],
      "why": "\"Shares a creature type with enchanted creature\" — sharesCreatureTypeWith reads only a trigger object."
    },
    {
      "name": "Faith's Shield",
      "needs": [
        "effect:player-protection-from-color"
      ],
      "why": "Fateful hour gives you protection from a chosen color."
    },
    {
      "name": "Eaten by Spiders",
      "needs": [
        "filter:attached-to-target"
      ],
      "why": "\"And all Equipment attached to that creature.\""
    },
    {
      "name": "Defang",
      "needs": [
        "replacement:prevent-damage-by-attached"
      ],
      "why": "Preventing the damage the enchanted creature would deal: the replacement's source filter can't name it."
    },
    {
      "name": "Ghoulflesh",
      "needs": [
        "static:add-color-to-attached"
      ],
      "why": "\"Is a black Zombie in addition to its other colors and types\": no static adds a color."
    },
    {
      "name": "Breathkeeper Seraph",
      "needs": [
        "effect:delayed-return-from-graveyard-your-next-upkeep"
      ],
      "why": "Re-triaged now soulbond is built: the granted dies trigger returns the card at the beginning of your next upkeep, a delayed return from the graveyard nothing expresses."
    },
    {
      "name": "Mirage Phalanx",
      "needs": [
        "effect:copy-exception-loses-ability"
      ],
      "why": "Re-triaged now soulbond is built: the token copy \"loses soulbond\" — no copy exception removes an ability."
    },
    {
      "name": "Donna Noble",
      "needs": [
        "trigger:paired-creature-dealt-damage"
      ],
      "why": "Re-triaged now soulbond is built: \"or a creature it's paired with is dealt damage\" — no trigger reads the partner."
    }
  ]
}
