 "blocked": [
  {
   "name": "Rediscover the Way",
   "needs": [
    "effect:delayed-trigger-rest-of-turn"
   ],
   "why": "Chapter III's \"Whenever you cast a noncreature spell this turn, target creature you control gains double strike\" is a turn-long, repeating delayed trigger that outlives the Saga; delayed-trigger's nextSpell fires only once, and granting spells a this-cast trigger would change the ability's source (colour, protection)."
  },
  {
   "name": "Fresh Start",
   "needs": [
    "static:static-lose-all-abilities"
   ],
   "why": "\"Enchanted creature gets -5/-0 and loses all abilities\" needs a static (Aura) lose-all-abilities in layer 6; losing abilities exists only as an effect modifier (lose-abilities), not a StaticAbility field."
  },
  {
   "name": "Purging Stormbrood // Absorb Essence",
   "needs": [
    "effect:remove-all-counters"
   ],
   "why": "The creature face's \"remove all counters from up to one target creature\" has no effect: remove-counter needs one named counter kind, and move-counters' \"all\" moves rather than removes."
  },
  {
   "name": "Songcrafter Mage",
   "needs": [
    "effect:grant-harmonize"
   ],
   "why": "\"Target instant or sorcery card in your graveyard gains harmonize until end of turn, its harmonize cost equal to its mana cost\" has no grant-harmonize effect (only grant-flashback); harmonize is a printed-only card field."
  },
  {
   "name": "Karakyk Guardian",
   "needs": [
    "condition:source-hasnt-dealt-damage"
   ],
   "why": "\"Has hexproof as long as it hasn't dealt damage yet\" needs a per-object record of whether it has dealt any damage since it entered; only dealt-damage-to-creature-this-turn is tracked."
  },
  {
   "name": "Stalwart Successor",
   "needs": [
    "trigger:counters-put-first-time-each-turn"
   ],
   "why": "\"If it's the first time counters have been put on that creature this turn\" is a per-creature first-time-each-turn intervening-if the counters-put trigger can't express (no firstTimeEachTurn, no per-object counter-placement history)."
  },
  {
   "name": "Rite of Renewal",
   "needs": [
    "effect:targets-from-target-players-graveyard"
   ],
   "why": "\"Target player shuffles up to four target cards from their graveyard into their library\" binds card targets to the graveyard of the player chosen in another target slot; card-in-graveyard's whose can't name a target slot."
  },
  {
   "name": "Ringing Strike Mastery",
   "needs": [
    "static:doesnt-untap-filter"
   ],
   "why": "\"Enchanted creature doesn't untap during its controller's untap step\": a static's doesntUntap only ever applies to the permanent carrying it (affects is ignored), so an Aura can't stop its enchanted creature untapping."
  },
  {
   "name": "Aggressive Negotiations",
   "needs": [
    "effect:exile-chosen-from-revealed-hand"
   ],
   "why": "\"You choose a nonland card from it and exile that card\": discard-chosen only discards, and look-and-choose's hand zone is the chooser's own hand, so nothing lets you pick a card from an opponent's revealed hand and exile it."
  },
  {
   "name": "Dragon's Prey",
   "needs": [
    "cost:cost-increase-if-targets"
   ],
   "why": "\"Costs {2} more to cast if it targets a Dragon\": targetCostReduction only reduces, and a negative reduceGeneric would be priced while offering as if a Dragon were always targeted whenever one is on the battlefield."
  },
  {
   "name": "Armament Dragon",
   "needs": [
    "effect:distribute-counters"
   ],
   "why": "\"Distribute three +1/+1 counters among one, two, or three target creatures\": with two targets the 2/1 split is the controller's choice as it's put on the stack, which no distributed-counters vocabulary carries (the same need blocks Revival of the Ancestors)."
  },
  {
   "name": "Fire-Rim Form",
   "needs": [
    "effect:attached-effect-ref"
   ],
   "why": "\"When this Aura enters, enchanted creature gains first strike until end of turn\": no EffectTargetRef names the creature the source Aura is attached to (grant-keyword takes a slot, source or trigger-object), and a static grant would have the wrong timing and follow the Aura to a new host."
  },
  {
   "name": "Riverwalk Technique",
   "needs": [
    "decision:owner-chooses-top-or-bottom"
   ],
   "why": "Mode 1 has the permanent's OWNER choose top or bottom of their library; put-on-library takes a fixed position and each-player-may can only ask the target's controller, which differs for a stolen permanent."
  },
  {
   "name": "Krumar Initiate",
   "needs": [
    "cost:dynamic-life-cost"
   ],
   "why": "\"{X}{B}, {T}, Pay X life\": an activated ability's payLife is a fixed number (or commander-identity-colors) and can't read the announced X."
  },
  {
   "name": "Narset's Rebuke",
   "needs": [
    "replacement:target-exile-if-dies-this-turn"
   ],
   "why": "\"If that creature would die this turn, exile it instead\": there is no turn-long die-to-exile replacement on a targeted creature."
  },
  {
   "name": "Arashin Sunshield",
   "needs": [
    "effect:targets-from-single-graveyard"
   ],
   "why": "\"Exile up to two target cards from a single graveyard\": a multi-target slot has no rule that all its targets share one graveyard, so two cards from two different graveyards would be legal."
  },
  {
   "name": "Severance Priest",
   "needs": [
    "effect:exile-chosen-from-revealed-hand"
   ],
   "why": "\"Target opponent reveals their hand. You may choose a nonland card from it. If you do, exile that card\": discard-chosen only discards, and nothing exiles a chosen card from another player's revealed hand linked to the source (exiledWith), which the leaves-the-battlefield token (Skyclave Apparition's shape, otherwise expressible) reads."
  },
  {
   "name": "Hundred-Battle Veteran",
   "needs": [
    "condition:counter-kinds-among-permanents"
   ],
   "why": "\"As long as there are three or more different kinds of counters among creatures you control\": no StaticCondition counts distinct counter kinds across permanents (the graveyard-cast-with-finality half was not checked further)."
  }
 ]
}
