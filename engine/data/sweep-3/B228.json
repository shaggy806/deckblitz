    {
      "name": "Fathom Seer",
      "needs": [
        "cost:morph-return-permanent"
      ],
      "why": "Morph's cost is \"Return two Islands you control to their owner's hand\"; morph.cost is a mana string only."
    },
    {
      "name": "Chronatog Totem",
      "needs": [
        "effect:skip-next-turn"
      ],
      "why": "Its animated creature's \"You skip your next turn\" ability: no skip-turn effect."
    },
    {
      "name": "Mishra, Artificer Prodigy",
      "needs": [
        "effect:search-hand-graveyard-library",
        "filter:same-name-as-trigger-spell"
      ],
      "why": "Searches graveyard, hand and/or library together for a card with the cast artifact spell's name."
    },
    {
      "name": "Weathered Bodyguards",
      "needs": [
        "replacement:damage-redirection"
      ],
      "why": "Combat damage unblocked creatures would deal to you is dealt to it instead while untapped."
    },
    {
      "name": "Crookclaw Transmuter",
      "needs": [
        "effect:switch-pt"
      ],
      "why": "Switch target creature's power and toughness: no switch effect."
    },
    {
      "name": "Chameleon Blur",
      "needs": [
        "replacement:prevent-all-damage-to-player"
      ],
      "why": "Prevent all damage creatures would deal to players this turn — prevent-damage-to-you covers only you and only combat damage."
    },
    {
      "name": "Premature Burial",
      "needs": [
        "filter:entered-since-your-last-turn-ended"
      ],
      "why": "\"Target nonblack creature that entered since your last turn ended\": enteredThisTurn can't say it."
    },
    {
      "name": "Cyclopean Giant",
      "needs": [
        "effect:set-land-type"
      ],
      "why": "Target land becomes a Swamp: setting the subtype doesn't remove its rules-text abilities (rule 305.7)."
    },
    {
      "name": "Dralnu, Lich Lord",
      "needs": [
        "replacement:damage-to-self-sacrifice-instead"
      ],
      "why": "Sacrifice that many permanents instead of the damage — the prevent-then-sacrifice shape lets damage triggers fire, the ruling says they don't."
    },
    {
      "name": "Gaze of Justice",
      "needs": [
        "cost:additional-cost-tap-permanents",
        "cost:flashback-tap-creatures-cost"
      ],
      "why": "Additional cost \"tap three untapped white creatures you control\" (and flashback with it)."
    },
    {
      "name": "Sengir Nosferatu",
      "needs": [
        "effect:return-exiled-card-named"
      ],
      "why": "Its Bat token returns an exiled card named Sengir Nosferatu: no choosing a card in exile by name."
    },
    {
      "name": "Thick-Skinned Goblin",
      "needs": [
        "static:echo-cost-zero-alternative",
        "keyword:echo"
      ],
      "why": "\"You may pay {0} rather than pay the echo cost for permanents you control\": echo is an upkeep unless-trigger with nothing marking it as an echo cost."
    },
    {
      "name": "Lim-Dûl the Necromancer",
      "needs": [
        "effect:add-subtypes-if-creature-on-entry"
      ],
      "why": "Returns the card and makes it a Zombie \"if it's a creature\" — addSubtypes on put-onto-battlefield is unconditional."
    },
    {
      "name": "Psionic Sliver",
      "needs": [
        "effect:damage-to-source"
      ],
      "why": "Granted \"deals 2 damage to any target and 3 damage to itself\": a damage effect can't target its own source."
    },
    {
      "name": "Aether Web",
      "needs": [
        "static:block-as-though-shadow"
      ],
      "why": "Enchanted creature can block creatures with shadow as though they didn't have shadow."
    },
    {
      "name": "Zealot il-Vec",
      "needs": [
        "effect:prevent-combat-damage-by-source"
      ],
