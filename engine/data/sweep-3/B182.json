  {
   "name": "Angelic Armaments",
   "needs": [
    "static:add-color-to-attached"
   ],
   "why": "Statics set colours outright; none adds white in addition to the others."
  },
  {
   "name": "Bruna, Light of Alabaster",
   "needs": [
    "effect:put-aura-cards-onto-battlefield-attached-to-self"
   ],
   "why": "Aura cards from hand or graveyard put onto the battlefield attached to Bruna can't be expressed."
  },
  {
   "name": "Burn at the Stake",
   "needs": [
    "cost:additional-cost-tap-permanents"
   ],
   "why": "No additional cost of tapping any number of untapped creatures whose count the effect reads."
  },
  {
   "name": "Courtly Provocateur",
   "needs": [
    "effect:must-block-this-turn"
   ],
   "why": "The second ability needs \"blocks this turn if able\"."
  },
  {
   "name": "Dark Impostor",
   "needs": [
    "filter:linked-exile-grant-card-type"
   ],
   "why": "`grantsActivatedOfLinkedExile` grants every linked card's abilities; only creature cards' should count (an exiled animated land mustn't)."
  },
  {
   "name": "Divine Deflection",
   "needs": [
    "replacement:prevent-and-reflect-damage"
   ],
   "why": "No \"prevent the next X damage, then deal that much to a target\" shield."
  },
  {
   "name": "Dread Slaver",
   "needs": [
    "trigger:dies-after-dealt-damage-by-source"
   ],
   "why": "`damagedThisTurnBy` can't say \"dealt damage by this creature\"."
  },
  {
   "name": "Druid's Familiar",
   "needs": [
    "keyword:soulbond"
   ],
   "why": "Soulbond (rule 702.95) isn't built: pairing, unpairing, and \"as long as paired\" statics."
  },
  {
   "name": "Elderscale Wurm",
   "needs": [
    "static:damage-life-floor"
   ],
   "why": "The life floor exists only as a player effect until end of turn, not a static gated on 7 or more life."
  },
  {
   "name": "Encrust",
   "needs": [
    "static:enchanted-abilities-cant-be-activated"
   ],
   "why": "A static `prohibits` takes a filter, and no filter names the enchanted permanent."
  },
  {
   "name": "Infinite Reflection",
   "needs": [
    "replacement:others-enter-as-copy"
   ],
   "why": "No replacement makes nontoken creatures enter as a copy of the enchanted creature."
  },
  {
   "name": "Lightning Mauler",
   "needs": [
    "keyword:soulbond"
   ],
   "why": "Soulbond (rule 702.95) isn't built: pairing, unpairing, and \"as long as paired\" statics."
  },
  {
   "name": "Mindclaw Shaman",
   "needs": [
    "zone:cast-from-opponents-hand"
   ],
