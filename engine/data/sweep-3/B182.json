  },
  {
   "name": "Misthollow Griffin",
   "needs": [
    "zone:cast-self-from-exile"
   ],
   "why": "No card field lets a card be cast from exile by its own permission."
  },
  {
   "name": "Nightshade Peddler",
   "needs": [
    "keyword:soulbond"
   ],
   "why": "Soulbond (rule 702.95) isn't built: pairing, unpairing, and \"as long as paired\" statics."
  },
  {
   "name": "Predatory Rampage",
   "needs": [
