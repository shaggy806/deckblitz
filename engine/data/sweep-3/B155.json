  "blocked": [
    {
      "name": "Warbringer",
      "needs": [
        "static:dash-cost-reduction"
      ],
      "why": "\"Dash costs you pay cost {2} less\": discounting the dash cost string before commander tax is added would take off too little from a dashed commander, so it needs a reduction applied to the whole cost."
    },
    {
      "name": "Salt Road Ambushers",
      "needs": [
        "trigger:turned-face-up-other"
      ],
      "why": "\"Whenever another permanent you control is turned face up\": the `turned-face-up` trigger has no `otherOnly`, so it would fire for itself too."
    },
    {
      "name": "Silumgar's Scorn",
      "needs": [
        "cost:additional-cost-reveal"
      ],
      "why": "\"As an additional cost, you may reveal a Dragon card from your hand\" isn't a spell cost; behold differs for copies and for a Dragon lost mid-cast (the rulings)."
    },
    {
      "name": "Scaleguard Sentinels",
      "needs": [
        "cost:additional-cost-reveal"
      ],
      "why": "Same optional Dragon reveal, and \"if you revealed a Dragon card or controlled a Dragon as you cast this\"."
    },
    {
      "name": "Gleam of Authority",
      "needs": [
        "static:pt-per-counters-among-permanents"
      ],
      "why": "+1/+1 for each +1/+1 counter on other creatures you control: `grantPtPerCount` counts counters only on the source or the affected creature."
    },
    {
      "name": "Display of Dominance",
      "needs": [
        "static:cant-be-targeted-by-filter"
      ],
      "why": "Mode 2: blue or black spells your opponents control can't target permanents you control this turn, later arrivals included — no such turn-long rule."
    },
    {
      "name": "Qarsi Deceiver",
      "needs": [
        "cost:spend-only-turn-face-up"
      ],
      "why": "Mana spendable only on face-down spells, morph costs and turning manifests face up — the last two are special actions."
    },
    {
      "name": "Gate Smasher",
      "needs": [
