  "blocked": [
    {
      "name": "Nim Deathmantle",
      "needs": [
        "effect:attach-extensions"
      ],
      "why": "'Return that card to the battlefield and attach this Equipment to it' — attaching the returned card isn't built; 'is a black Zombie' is."
    },
    {
      "name": "Frozen in Ice",
      "needs": [
        "static:cant-become-untapped"
      ],
      "why": "The loss of abilities is built; 'can't become untapped' (no untap by any means) isn't — doesnt-untap covers only the untap step."
    },
    {
      "name": "Enchanted River's Grasp",
      "needs": [
        "effect:remove-all-counters"
      ],
      "why": "The loss is built; 'remove all counters from it' as it enters isn't."
    },
    {
      "name": "Heliod's Punishment",
      "needs": [
        "static:aura-grants-ability-referencing-aura"
      ],
      "why": "The loss is built; the granted '{T}: Remove a task counter from Heliod's Punishment' names the Aura, not the creature."
    },
    {
      "name": "Titania's Song",
      "needs": [
        "static:animate-pt-equal-mana-value",
        "static:effect-lingers-until-eot-after-leaving"
      ],
      "why": "The loss is built; P/T each equal to its mana value on a static, and the effect lasting until end of turn after it leaves, aren't."
    },
    {
      "name": "Unable to Scream",
      "needs": [
        "mechanic:face-down"
      ],
      "why": "The loss and Toy artifact creature are built; 'as long as enchanted creature is face down, it can't be turned face up' isn't."
    },
    {
      "name": "Witness Protection",
      "needs": [
        "static:set-name"
      ],
      "why": "The loss, colours, types and P/T are built; 'named Legitimate Businessperson' (a static setting the name) isn't."
    },
    {
      "name": "Blaze of Glory",
      "needs": [
        "effect:blocks-each-attacker-if-able"
      ],
      "why": "'Can block any number of creatures this turn' is built; 'it blocks each attacking creature this turn if able' (a requirement per attacker) isn't."
    },
    {
      "name": "Kemba's Legion",
      "needs": [
        "static:block-additional-per-count"
      ],
      "why": "blockAdditional takes a number; 'an additional creature for each Equipment attached to it' needs a live count."
    },
    {
      "name": "Guardian of the Gateless",
      "needs": [
        "amount:creatures-blocking-it"
      ],
      "why": "'Can block any number' is built; '+1/+1 for each creature it's blocking' isn't."
    },
    {
      "name": "Gornog, the Red Reaper",
      "needs": [
        "static:cant-block-by-subtype"
      ],
      "why": "'Becomes a Coward' is built; 'Cowards can't block Warriors' isn't."
    },
    {
      "name": "Boldwyr Intimidator",
      "needs": [
        "static:cant-block-by-subtype"
      ],
      "why": "'Becomes a Coward/Warrior until end of turn' is built; 'Cowards can't block Warriors' isn't."
    },
    {
      "name": "Soul Sculptor",
      "needs": [
        "duration:until-a-player-casts-creature-spell"
      ],
      "why": "'Becomes an enchantment and loses all abilities' is expressible; the duration 'until a player casts a creature spell' isn't."
    },
    {
      "name": "Shade's Breath",
      "needs": [
        "effect:set-color-all",
        "effect:set-creature-type-all"
      ],
      "why": "Each creature you control becoming a black Shade with an ability: no mass type/colour set."
    },
    {
      "name": "Standardize",
      "needs": [
        "effect:set-creature-type-all"
      ],
      "why": "The choice excluding Wall is built; 'each creature becomes that type' has no mass form."
    },
    {
      "name": "Mistform Wakecaster",
      "needs": [
        "effect:set-creature-type-all"
      ],
      "why": "'Each creature you control becomes that type until end of turn' has no mass form (add-types takes one target)."
    },
    {
      "name": "Yare",
      "needs": [
        "target:creature-defending-player-controls-spell"
      ],
      "why": "'Target creature defending player controls' on an instant: the defending player is found only from an attacking source."
    },
    {
      "name": "Song of the Dryads",
      "needs": [
        "static:land-type-setting"
      ],
      "why": "'Is a colorless Forest land' needs rule 305.7's loss of its rules-text abilities only (abilities other effects gave it stay) — loseAllAbilities would take those too."
    },
    {
      "name": "Dragon Hunter",
      "needs": [
        "static:block-as-though-reach-filter"
      ],
      "why": "'Can block Dragons as though it had reach' isn't built."
    },
    {
      "name": "Lairwatch Giant",
      "needs": [
        "trigger:blocks-two-or-more"
      ],
      "why": "Can block an additional creature is built; 'whenever this blocks two or more creatures' isn't."
    },
    {
      "name": "Mistform Warchief",
      "needs": [
        "condition:filter-shares-creature-type-with-source"
      ],
      "why": "The type choice is built; 'creature spells that share a creature type with this cost {1} less' isn't."
    },
    {
      "name": "Vraska, Betrayal's Sting",
      "needs": [
        "amount:target-player-counters"
      ],
      "why": "Her -9 reads the target player's poison count ('the difference'); playerCounters reads only you, an opponent or that-player."
    }
  ]
