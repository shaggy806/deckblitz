  "blocked": [
    {
      "name": "Visions of Brutality",
      "needs": [
        "trigger:deals-damage-once-per-event"
      ],
      "why": "'Whenever enchanted creature deals damage, its controller loses that much life' triggers once per damage event (the rulings); `deals-damage` fires once per recipient."
    },
    {
      "name": "Dazzling Reflection",
      "needs": [
        "replacement:prevent-damage-by-target-this-turn"
      ],
      "why": "Prevents the next damage dealt by the target creature this turn; prevention shields only cover damage dealt to something or by a source chosen on resolution."
    },
    {
      "name": "Dread Defiler",
      "needs": [
        "effect:cost-exiled-cards-this-way"
      ],
      "why": "Damage equal to the power of the creature card exiled to pay the cost: no amount reads a cost-exiled card."
    },
    {
      "name": "Mindmelter",
      "needs": [
        "effect:target-player-exiles-from-hand"
      ],
      "why": "'Target opponent exiles a card from their hand': no target-player hand exile."
    },
    {
      "name": "Hedron Alignment",
      "needs": [
        "condition:owns-named-card-in-every-zone"
      ],
      "why": "Win condition reads cards named Hedron Alignment across hand, graveyard, exile and battlefield, after an optional reveal of your hand."
    },
    {
      "name": "Synthetic Destiny",
      "needs": [
        "effect:delayed-count-done-this-way"
      ],
      "why": "The end-step delayed trigger must remember how many creatures were exiled."
    },
    {
      "name": "Wretched Confluence",
      "needs": [
        "effect:modal-repeat-modes"
      ],
      "why": "'You may choose the same mode more than once': castModal can't repeat a mode."
    },
    {
      "name": "Deceiver of Form",
      "needs": [
        "effect:become-copy-filter-except-source"
      ],
      "why": "'Creatures you control other than this creature become copies': become-copy's filter can't leave out the source."
    },
    {
      "name": "Flaying Tendrils",
      "needs": [
        "replacement:turn-exile-if-dies-filter"
      ],
      "why": "'If a creature would die this turn, exile it instead' covers every creature for the turn, not a target or the creatures it damaged."
