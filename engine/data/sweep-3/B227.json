    {
      "name": "Bubbling Beebles",
      "needs": [
        "condition:defending-player-controls"
      ],
      "why": "Can't be blocked as long as defending player controls an enchantment: no condition reads what the defending player controls."
    },
    {
      "name": "Land Grant",
      "needs": [
        "cost:alt-cost-reveal-hand"
      ],
      "why": "Alternative cost: reveal your hand if it holds no land cards; no such alternative cost."
    },
    {
      "name": "Uphill Battle",
      "needs": [
        "replacement:enters-tapped-if-cast"
      ],
      "why": "Creatures played (cast) by opponents enter tapped; no enters-tapped replacement filters on whether the creature was cast."
    },
    {
      "name": "Charisma",
      "needs": [
        "effect:gain-control-trigger-recipient"
      ],
      "why": "Gain control of the creature enchanted creature dealt damage to: gain-control can't name the damage trigger's recipient."
    },
    {
      "name": "Vernal Equinox",
      "needs": [
        "effect:flash-for-each-player"
      ],
      "why": "Any player may cast creatures and enchantments as though they had flash; castAsThoughFlash covers only the controller."
    },
    {
      "name": "Bargaining Table",
      "needs": [
        "cost:x-equals-chosen-opponent-hand"
      ],
      "why": "X is the number of cards in a chosen opponent's hand, the opponent chosen as it's activated (ruling)."
    },
    {
      "name": "Sowing Salt",
      "needs": [
        "effect:extract-same-name"
      ],
      "why": "Search the controller's graveyard, hand and library for every card with the land's name."
    },
    {
      "name": "Remote Farm",
      "needs": [
        "cost:depletion-counter-lands",
        "effect:mana-ability-side-effects"
      ],
      "why": "A depletion land: its mana ability removes a counter and sacrifices it when none are left."
    },
    {
      "name": "Thieves' Auction",
      "needs": [
        "effect:each-player-chooses-in-turn-order",
        "effect:repeat-process"
      ],
      "why": "Players take turns choosing exiled cards to put onto the battlefield until none are left."
    },
    {
      "name": "Crackdown",
      "needs": [
        "filter:static-affects-by-power"
      ],
      "why": "Nonwhite creatures with power 3 or greater don't untap: a static's affects filter can't read power."
    },
