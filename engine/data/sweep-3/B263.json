 "blocked": [
  {
   "name": "Accursed Witch",
   "needs": [
    "static:cost-reduction-targeting-enchanted-player"
   ],
   "why": "Infectious Curse's \"spells you cast that target enchanted player cost {1} less\" has no form: costModification.targeting matches objects only."
  },
  {
   "name": "Chandra, Pyromaster",
   "needs": [
    "effect:choose-exiled-card-cast-copies"
   ],
   "why": "The -7 chooses one instant or sorcery among the ten exiled and casts three copies of it; cast-now from exiled-this-way with copies copies each card."
  },
  {
   "name": "Elkin Lair",
   "needs": [
    "effect:delayed-exiled-unplayed-to-graveyard"
   ],
   "why": "The random exile with a play permission is expressible; the end-step move of the card if it wasn't played has no form."
  },
  {
   "name": "Advanced Reconstruction",
   "needs": [
    "cost:cost-reduction-cast-not-from-hand"
   ],
   "why": "costModification.castFrom is a list of zones and can't say \"not from your hand\", which takes in a spell cast from an opponent's hand."
  },
  {
   "name": "Summon: Brynhildr",
   "needs": [
    "effect:trigger-spell-gains-keyword"
   ],
   "why": "\"When you next cast a creature spell this turn, it gains haste\": the permanent that spell becomes can't be given the keyword."
  },
  {
   "name": "Candles' Glow",
   "needs": [
    "effect:prevent-damage-gain-life-as-prevented"
   ],
   "why": "The life is gained when the damage is prevented, later than the spell resolves."
  },
  {
   "name": "Thijarian Witness",
   "needs": [
    "condition:was-attacking-or-blocking-alone-lki"
   ],
   "why": "Counting the attackers left after it dies is wrong when two attackers die together."
  },
  {
   "name": "Viper, Cruel Conspirator",
   "needs": [
    "filter:attacking-alone"
   ],
   "why": "No target filter for \"creature that's attacking alone\"."
  },
  {
   "name": "Explosive Singularity",
   "needs": [
    "cost:cost-reduction-per-tapped-for-cost"
   ],
   "why": "additionalCost.also.tapAnyNumber exists but nothing lowers the cost by {1} per creature tapped."
  },
  {
   "name": "Nahiri's Wrath",
   "needs": [
    "amount:discarded-as-cost-total-mana-value"
   ],
   "why": "Nothing sums the mana values of X cards discarded as the cost."
  },
  {
   "name": "Protection Racket",
   "needs": [
    "decision:each-opponent-may-pay-life-for-revealed-card"
   ],
   "why": "may.costLife asks the controller; here each opponent decides and pays."
  },
  {
   "name": "Atalya, Samite Master",
   "needs": [
    "cost:spend-only-color-on-x"
   ],
   "why": "No form restricts the mana spent on X to one colour."
  },
  {
   "name": "Rosheen, Roaring Prophet",
   "needs": [
    "cost:mana-ability-reveal-any-number"
   ],
   "why": "No mana ability chooses and reveals cards as it resolves and scales its mana by the count."
  },
