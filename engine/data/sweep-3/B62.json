   "needs": [
    "trigger:opponents-attacked-batch"
   ],
   "why": "'Whenever one or more of your opponents are attacked' fires once per attack; attacks-player fires once per opponent attacked."
  },
  {
   "name": "Quintessential Katana",
   "needs": [
    "trigger:deals-combat-damage-once-per-event"
   ],
   "why": "The granted 'whenever this creature deals combat damage' triggers once per damage step (rulings); deals-damage fires once per recipient."
  },
  {
