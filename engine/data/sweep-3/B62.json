   "needs": [
    "effect:linked-exile-token-copy"
   ],
   "why": "Chapters II-III copy 'a card exiled with this Saga'; create-token-copy has no linked-exile source."
  },
  {
   "name": "Northampton Farm",
   "needs": [
    "effect:return-linked-filter"
   ],
   "why": "Returns one chosen creature card exiled with it to the battlefield and each other linked card to hand; return-exiled-by-source sends all to one zone."
  },
