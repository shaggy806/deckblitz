  "blocked": [
    {
      "name": "Dead Reckoning",
      "needs": [
        "amount:power-before-move"
      ],
      "why": "\"Damage equal to that card's power\" is read after the card has gone to the library; the ruling reads the power it had in the graveyard (Tarmogoyf, Lord of Extinction)."
    },
    {
      "name": "Rumbling Aftershocks",
      "needs": [
        "amount:trigger-spell-times-kicked"
      ],
      "why": "The damage is the triggering spell's kick count, read as it last existed if that spell has left the stack; only the source's count is an amount."
    },
    {
      "name": "Voyager Drake",
      "needs": [
        "target:up-to-x-times-kicked"
      ],
      "why": "\"Up to X target creatures, where X is the number of times this creature was kicked\": no target bound reads the kick count."
    },
    {
      "name": "Strength of the Tajuru",
      "needs": [
        "keyword:multikicker-target-per-kick"
      ],
      "why": "One more target for each time it was kicked."
    },
    {
      "name": "Novablast Wurm",
      "needs": [
        "effect:destroy-all-except-source"
      ],
      "why": "\"Destroy all other creatures\" — destroy-all has no except-source; a name filter would spare a second Wurm (the ruling)."
    },
    {
      "name": "Searing Blaze",
      "needs": [
        "target:controlled-by-target-player"
      ],
      "why": "The creature target must be controlled by the first target player (or that planeswalker's controller)."
    },
    {
      "name": "Roiling Terrain",
      "needs": [
        "effect:count-in-target-player-graveyard"
      ],
      "why": "Counts land cards in the destroyed land's controller's graveyard."
    },
    {
      "name": "Selective Memory",
      "needs": [
        "effect:search-library-to-exile"
      ],
      "why": "Search for any number of nonland cards and exile them: search-library has no exile destination."
    },
    {
      "name": "Treasure Hunt",
      "needs": [
        "effect:reveal-until-rest-to-hand"
      ],
      "why": "All cards revealed go to hand: reveal-until's rest can't go to hand."
    },
    {
      "name": "Refraction Trap",
      "needs": [
        "amount:damage-prevented-this-way",
        "replacement:damage-prevented-to-filter"
      ],
      "why": "Prevents the next 3 damage a chosen source would deal to you and/or permanents you control, then deals that much to any target."
    },
    {
      "name": "Sejiri Steppe",
      "needs": [
        "effect:grant-protection-choice"
      ],
      "why": "Protection from a colour chosen as the ability resolves."
    },
    {
      "name": "Feral Contest",
      "needs": [
        "effect:must-block-this-turn"
      ],
      "why": "\"Another target creature blocks it this turn if able\"."
    },
    {
      "name": "Razor Boomerang",
      "needs": [
        "cost:unattach-cost"
      ],
      "why": "The granted ability costs \"Unattach Razor Boomerang\"."
    },
    {
      "name": "Mire's Toll",
      "needs": [
        "effect:reveal-n-from-hand-you-choose-discard"
      ],
      "why": "The player reveals N cards of their choice (N = Swamps you control), and you choose one to discard."
    },
    {
      "name": "Quest for the Nihil Stone",
      "needs": [
        "condition:that-player-hand-size"
      ],
      "why": "\"If that player has no cards in hand\" — the opponent whose upkeep it is; hand-size checks only you or each player."
    },
    {
      "name": "Calcite Snapper",
      "needs": [
        "effect:switch-pt"
      ],
      "why": "Landfall: switch its power and toughness until end of turn."
    }
  ]
}
