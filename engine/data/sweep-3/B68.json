 "blocked": [
  {
   "name": "Lunar Insight",
   "needs": [
    "effect:count-distinct-mana-values"
   ],
   "why": "Draw a card for each different mana value among nonland permanents you control."
  },
  {
   "name": "Neerdiv, Devious Diver",
   "needs": [
    "trigger:activates-ability"
   ],
   "why": "'Or activate an ability of a card in your graveyard' — activates-ability only watches attached sources."
  },
  {
   "name": "Frontline Heroism",
   "needs": [
    "effect:copy-spell-extensions"
   ],
   "why": "A copy of the spell retargeted at the token the same effect just created."
  },
  {
   "name": "Aphelia, Viper Whisperer",
   "needs": [
    "effect:delayed-trigger-extensions"
   ],
   "why": "Until end of turn, whenever one or more Gorgons and/or Snakes you control deal combat damage to a player — a turn-long batched delayed trigger."
  },
  {
   "name": "Dropkick Bomber",
   "needs": [
    "trigger:deals-combat-damage-once-per-event"
   ],
   "why": "The granted 'When this creature deals combat damage, sacrifice it' fires once per combat damage event (603.2c), not once per recipient."
  },
  {
   "name": "Unidentified Hovership",
   "needs": [
    "effect:player-scope-extensions"
   ],
   "why": "The exiled card's owner manifests dread — manifest-dread's who takes only you or a target's controller."
  },
  {
   "name": "Marina Vendrell's Grimoire",
   "needs": [
    "static:no-loss-for-zero-life"
   ],
   "why": "You don't lose the game for having 0 or less life."
  },
  {
   "name": "Valgavoth's Onslaught",
   "needs": [
    "effect:manifested-this-way",
    "effect:amount-fields-dynamic"
   ],
   "why": "Manifest dread X times, then counters on each of those creatures — manifest-dread's count is fixed and nothing names the manifested creatures."
  },
  {
   "name": "Osseous Sticktwister",
   "needs": [
    "effect:each-player-chooses-then-all-act"
   ],
   "why": "Each opponent chooses in turn order, then all act at once (ruling); each-player-may does each player's before asking the next — Perforating Artist's block."
  },
  {
   "name": "Central Elevator // Promising Stairs",
   "needs": [
    "condition:filter-same-name-as-permanent-you-control",
    "condition:control-distinct-names-count"
   ],
   "why": "A Room card that doesn't share a name with a Room you control (any one name, unlocked doors only); Promising Stairs counts distinct names among unlocked doors."
  },
  {
   "name": "Moldering Gym // Weight Room",
   "needs": [
    "effect:manifested-this-way"
   ],
   "why": "Weight Room: manifest dread, then put three +1/+1 counters on that creature."
  },
  {
   "name": "Norin, Swift Survivalist",
   "needs": [
    "zone:impulse-permission-options"
   ],
   "why": "'You may play that card' — exile's mayCast is cast-only, so a land creature card couldn't be played."
  },
  {
   "name": "Carrot Cake",
   "needs": [
    "trigger:self-sacrifice-trigger"
   ],
   "why": "'When you sacrifice this' — the sacrifice trigger has no self-only scope, and a name filter fires for another Carrot Cake."
  },
  {
   "name": "Feed the Cycle",
   "needs": [
    "keyword:forage"
   ],
   "why": "Forage as an additional cost."
  },
  {
   "name": "Huskburster Swarm",
   "needs": [
    "cost:cost-reduction-cards-in-exile"
   ],
   "why": "{1} less for each creature card you own in exile and in your graveyard."
  },
  {
   "name": "Cloudspire Coordinator",
   "needs": [
    "stat:entered-this-turn-as-entered"
   ],
   "why": "Mounts and/or Vehicles that entered this turn, counted as they entered, not as they are now (B67's crew block lifted)."
  },
  {
   "name": "Valor's Flagship",
   "needs": [
    "cost:cycling-x"
   ],
   "why": "Cycling {X}{2}{W} and a cycle trigger reading X (B67's crew block lifted)."
  }
 ]
