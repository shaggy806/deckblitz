 "blocked": [
  {
   "name": "Stone-Tongue Basilisk",
   "needs": [
    "trigger:trigger-recipient-ref"
   ],
   "why": "\"Destroy that creature at end of combat\" off its combat-damage trigger: the delayed trigger doesn't carry the creature it damaged."
  },
  {
   "name": "Last Rites",
   "needs": [
    "effect:discard-chosen-exact-count"
   ],
   "why": "A nonland card for each card discarded this way is an exact count; discard-chosen's upTo would let the caster take fewer."
  },
  {
   "name": "Tattoo Ward",
   "needs": [
    "static:protection-except-this-aura"
   ],
   "why": "Protection from enchantments that doesn't remove this Aura (rule 702.16d); nothing exempts the granting Aura."
  },
  {
   "name": "Decompose",
   "needs": [
    "effect:targets-from-single-graveyard"
   ],
   "why": "Up to three target cards from a single graveyard: any-number graveyard targets can't be held to one graveyard."
  },
  {
   "name": "Luminous Guardian",
   "needs": [
    "static:block-additional-creature"
   ],
   "why": "\"Can block an additional creature each combat\" until end of turn has no shape."
  },
  {
   "name": "Traveling Plague",
   "needs": [
    "effect:return-aura-after-host-died"
   ],
   "why": "When enchanted creature leaves, its controller returns this Aura from its owner's graveyard attached to a creature of their choice, under their control."
  },
  {
   "name": "Whipkeeper",
   "needs": [
    "amount:damage-dealt-to-target-creature-this-turn"
   ],
   "why": "The damage already dealt to the target this turn, regenerated damage included; turnStat counts only damage to players."
  },
  {
   "name": "Graceful Antelope",
   "needs": [
    "static:land-type-setting"
   ],
   "why": "Target land becomes a Plains for as long as this remains on the battlefield."
  },
  {
   "name": "Ember Beast",
   "needs": [
    "static:cant-attack-or-block-alone"
   ],
   "why": "Can't attack or block alone has no restriction."
  },
  {
   "name": "Pilgrim of Virtue",
   "needs": [
    "replacement:prevent-next-damage-from-chosen-source-any-recipient"
   ],
   "why": "The next time a black source of your choice would deal damage this turn, to anything, prevent it."
  },
  {
   "name": "Pilgrim of Justice",
   "needs": [
    "replacement:prevent-next-damage-from-chosen-source-any-recipient"
   ],
   "why": "As Pilgrim of Virtue, for a red source."
  },
  {
   "name": "Pardic Firecat",
   "needs": [
    "filter:counts-as-named-card"
   ],
   "why": "\"If a card named Flame Burst is in a graveyard, it counts as Pardic Firecat\": nothing makes a card count as another name."
  },
  {
   "name": "Cursed Monstrosity",
   "needs": [
    "effect:unless-discard-filtered-card"
   ],
   "why": "Sacrifice it unless you discard a land card: the unless discard option has no filter."
  },
  {
   "name": "Savage Firecat",
   "needs": [
    "trigger:tapped-for-mana-nonmana-trigger"
   ],
   "why": "\"Whenever you tap a land for mana\" removing a counter uses the stack; tapped-for-mana is only a triggered mana ability."
  },
  {
   "name": "Liquid Fire",
   "needs": [
    "cost:choose-number-additional"
   ],
   "why": "Choosing a number between 0 and 5 as an additional cost; a castModal of six modes would make it a modal spell."
  },
  {
   "name": "Spellbane Centaur",
   "needs": [
    "static:cant-be-targeted-by-filter"
   ],
   "why": "Can't be the target of blue spells or abilities from blue sources, its controller's too; hexproofFrom is only opponents'."
  },
  {
   "name": "Engulfing Flames",
   "needs": [
    "effect:cant-be-regenerated-this-turn"
   ],
   "why": "\"It can't be regenerated this turn\" after damage: only destroy effects carry cantBeRegenerated."
  },
  {
   "name": "Aether Burst",
   "needs": [
    "decision:target-count-amount"
   ],
   "why": "Up to one plus the number of Aether Bursts in all graveyards targets: any-number's max is only a number or X."
  },
  {
   "name": "Sandstone Deadfall",
   "needs": [
    "cost:sacrifice-self-and-another"
   ],
   "why": "Sacrifice two lands and this artifact as one cost."
  },
  {
   "name": "Hint of Insanity",
   "needs": [
    "effect:discard-duplicate-names"
   ],
   "why": "Discard all nonland cards with the same name as another card in that hand."
  },
  {
   "name": "Steam Vines",
   "needs": [
    "effect:attach-aura-to-land-chosen-by-player"
   ],
   "why": "After destroying the land, that land's controller attaches Steam Vines to a land of their choice."
  },
  {
   "name": "Shifty Doppelganger",
   "needs": [
    "effect:return-if-sacrificed-this-way"
   ],
   "why": "Sacrifice that creature at the next end step; if you do, return this card from exile."
  },
  {
   "name": "Repentant Vampire",
   "needs": [
    "trigger:creature-damaged-by-source-dies",
    "filter:damaged-this-turn-by-source"
   ],
   "why": "Whenever a creature dealt damage by this creature this turn dies."
  },
  {
   "name": "Dreamwinder",
   "needs": [
    "condition:defending-player-controls",
    "effect:set-land-type"
   ],
   "why": "Can't attack unless defending player controls an Island; target land becomes an Island until end of turn."
  },
  {
   "name": "Balshan Beguiler",
   "needs": [
    "effect:reveal-top-opponent-library-you-choose-to-graveyard"
   ],
   "why": "That player reveals the top two cards; you choose one to put into their graveyard."
  },
  {
   "name": "Resilient Wanderer",
   "needs": [
    "effect:grant-protection-temporary",
    "effect:grant-protection-choice"
   ],
   "why": "Protection from the color of your choice until end of turn."
  },
  {
   "name": "Mad Dog",
   "needs": [
    "condition:came-under-control-this-turn"
   ],
   "why": "\"If it didn't attack or come under your control this turn\" has no came-under-control condition."
  },
  {
   "name": "Famished Ghoul",
   "needs": [
    "effect:targets-from-single-graveyard"
   ],
   "why": "Up to two target cards from a single graveyard."
  },
  {
   "name": "Haunting Echoes",
   "needs": [
    "effect:search-opponent-library",
    "effect:extract-same-name"
   ],
   "why": "Search its owner's library for all cards with the same name as each card exiled this way."
  },
  {
   "name": "Tombfire",
   "needs": [
    "condition:filter-has-flashback"
   ],
   "why": "Exile all cards with flashback from target player's graveyard: no filter for flashback."
  }
