  "blocked": [
    {
      "name": "Tomik, Orzhov Lawmage",
      "needs": [
        "static:attack-limit"
      ],
      "why": "Planeswalkers you control have 'No more than one creature can attack this planeswalker each combat' — no static limits how many creatures may attack a given defender."
    },
    {
      "name": "Proctor of Potential",
      "needs": [
        "stat:scried-or-surveilled-this-turn"
      ],
      "why": "Graveyard return's 'Activate only if you've scried or surveilled this turn' — no per-turn record or condition for having scried/surveilled."
    },
    {
      "name": "Theorist's Proxy",
      "needs": [
        "static:next-spell-uncounterable"
      ],
      "why": "'{U}, Sacrifice: The next spell you cast this turn can't be countered' — a one-shot grant to a future spell; a nextSpell delayed trigger would leave a window."
    },
    {
      "name": "Loot, the Nexus",
      "needs": [
        "effect:count-distinct-powers"
      ],
      "why": "'Add one mana of that color for each different power among creatures you control' — no EffectAmount counts distinct power values."
    },
    {
      "name": "Dark Matter Manipulator",
      "needs": [
        "static:pt-per-count-step"
      ],
      "why": "'+2/+0 for every seven cards in your graveyard' — grantPtPerCount has no per-N step (floor(count / 7))."
    },
    {
      "name": "Face Yourself",
      "needs": [
        "effect:token-copy-each-of-target-players"
      ],
      "why": "\"For each creature target player controls, create a token copy\": create-token-copy's { each } filter can't point at a targeted player's permanents (controlledBy is only you/opponent/active-player); the haste + intervening-if end-step sacrifice exception is expressible."
    },
    {
      "name": "Sphinx's Approach",
      "needs": [
        "mechanic:deck-any-number-copies",
        "cost:may-exile-self-and-named-from-graveyard"
      ],
      "why": "'A deck can have any number of cards named Sphinx's Approach' has no singleton exemption in deck validation, and 'you may exile this spell and four cards named ~ from your graveyard. If you do, …' (the resolving spell itself plus four named cards, all or nothing) has no vocabulary."
    },
    {
      "name": "Omnipresence",
      "needs": [
        "cost:free-cast-from-hand-static"
      ],
      "why": "A static 'you may cast spells … from your hand without paying their mana costs' (MV <= creatures you control) — only a temporary player effect (castFromHandFree, Yusri) or a one-shot cast-now exists."
    },
    {
      "name": "Cruel Calculations",
      "needs": [
        "stat:cards-library-to-graveyard-this-turn"
      ],
      "why": "X counts cards put into target player's graveyard from their library this turn, including ones that have since left; no TurnStat counts library-only (cards-to-graveyard-from-hand-or-library includes discards), and the putIntoGraveyardFromLibraryThisTurn card marker only sees cards still there."
    },
    {
      "name": "Diviner of Victory // Unwind History",
      "needs": [
        "trigger:scry-trigger"
      ],
      "why": "'Whenever you scry or surveil': only a `surveils` trigger exists; no scry trigger (the `predicate` hatch can't see the source's controller). Its spell Unwind History not authored either."
    },
    {
      "name": "Pyre Rhymer // Molten Tide",
      "needs": [
        "effect:turn-scoped-mana-trigger"
      ],
      "why": "Molten Tide: 'Until end of turn, whenever you tap a Mountain for mana, add an additional {R}' is a turn-scoped triggered mana ability (High Tide's shape), not built. Molten Tide not authored."
    },
    {
      "name": "Heartwood Crafter // Soul Tether",
      "needs": [
        "cost:mana-restriction-not-from-hand"
      ],
      "why": "'{T}: Add {C}. This mana can't be spent to cast spells from your hand': ManaRestriction has no cast-from-zone deny clause (notSpell's castFrom is unset while the card is still in hand as it's paid for)."
    },
    {
      "name": "Stensian Sanguinist // Exsanguinate",
      "needs": [
        "effect:delayed-combat-damage-this-combat"
      ],
      "why": "'Whenever that creature deals combat damage to a player this combat': DelayedCombatDamage lasts the turn, so an extra combat would wrongly prepare it."
    }
  ]
}
