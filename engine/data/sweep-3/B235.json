  "blocked": [
    {
      "name": "Auron, Venerated Guardian",
      "needs": [
        "bug:reflexive-target-compare-bound-at-creation"
      ],
      "why": "A reflexive trigger's target filter comparing with the source's live power is bound to a number when the trigger is created, so the resolution recheck reads a stale value."
    },
    {
      "name": "Ardyn, the Usurper",
      "needs": [
        "bug:token-copy-skips-as-enters-choices"
      ],
      "why": "create-token-copy never asks the copied card's as-enters choices, so a token copy enters with nothing chosen."
    },
    {
      "name": "Avatar Destiny",
      "needs": [
        "bug:simultaneous-move-with-choice"
      ],
      "why": "A simultaneous move can't hold a step that asks a question, so \"return this card and up to one creature card milled this way\" splits into two leave events."
    },
    {
      "name": "Kellan, the Fae-Blooded",
      "needs": [
        "static:pt-per-attachments-on-source"
      ],
      "why": "A static +N/+0 per Aura and Equipment attached to the static's own source: grantPtPerCount's attachedTo can't name the source."
    },
    {
      "name": "Continue?",
      "needs": [
        "filter:put-into-graveyard-from-battlefield-this-turn"
      ],
      "why": "No filter clause for a card put into a graveyard from the battlefield this turn."
    },
    {
      "name": "Elspeth, Knight-Errant",
      "needs": [
        "effect:emblem-static-abilities"
      ],
      "why": "An emblem static applies only with scope creatures-you-control: \"Artifacts, creatures, enchantments, and lands you control have indestructible\" does nothing."
    },
    {
      "name": "Liliana's Triumph",
      "needs": [
        "effect:hidden-simultaneous-choices"
      ],
      "why": "The each-opponent discard resolves one player at a time in view of the next; the ruling has all choose hidden, then discard at once."
    },
    {
      "name": "Show and Tell",
      "needs": [
        "effect:each-player-chooses-then-all-act"
      ],
      "why": "each-player-may putFromHand puts each player's card in as they choose; the ruling has all choose first, then all enter at once."
    },
    {
      "name": "Abyssal Harvester",
      "needs": [
        "condition:put-into-graveyard-this-turn-any-zone",
        "bug:token-copy-skips-as-enters-choices"
      ],
      "why": "Only putIntoGraveyardFromLibraryThisTurn exists; and the token copy's as-enters abilities must work (ruling)."
    },
    {
      "name": "Rebuild the City",
      "needs": [
        "bug:token-copy-skips-as-enters-choices"
      ],
      "why": "A token copy of a land with an as-enters choice is never asked it (ruling: the copy's as-enters choices work)."
    },
    {
      "name": "Yenna, Redtooth Regent",
      "needs": [
        "bug:token-copy-skips-as-enters-choices"
      ],
      "why": "A token copy's as-enters abilities must work (ruling); create-token-copy never asks them."
    },
