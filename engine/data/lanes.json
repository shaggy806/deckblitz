 "groups": [
  {
   "keys": [
    "effect:possibility-storm-exile-spell-on-cast",
    "effect:exile-target-spell",
    "effect:exile-spell-as-it-resolves-linked",
    "effect:exile-spell-as-it-resolves-with-counter",
    "effect:put-cast-spell-on-library-if-did",
    "effect:exile-cast-spell-then-cast-linked-exiled"
   ],
   "why": "All move a spell off the stack to exile or a library (Possibility Storm, Gale's Redirection, Forger's Foundry, Goliath Daydreamer, Neera, Knowledge Pool): one stack-to-zone move with its link/counter/as-it-resolves options. casting-zones."
  },
  {
   "keys": [
    "effect:flicker-chosen-group",
    "effect:flicker-source-and-chosen",
    "effect:choose-permanents-this-way"
   ],
   "why": "An untargeted chosen set acted on together: flicker over a choose-permanents set (Nahiri's Resolve, Fortune), and the same set read by later steps (Spry and Mighty's thisWay chosen). One 'chosen this way' set ref."
  },
  {
   "keys": [
    "effect:token-copy-of-sacrificed",
    "effect:token-copy-of-graveyard-cards",
    "effect:token-copy-enters-attached"
   ],
   "why": "create-token-copy's `of` widened: a paid/sacrificed object's copiable values (LKI), every card matching a filter in a zone, and an attached-to form."
  },
  {
   "keys": [
    "filter:shares-creature-type-with-convokers",
    "filter:shares-creature-type-with-each-of-set"
   ],
   "why": "sharesCreatureTypeWith over a set: the convoking creatures, and 'each of' the tapped set rather than 'any of' (Everything Comes to Dust, Cryptic Gateway)."
  },
  {
   "keys": [
    "decision:zone-choice-card-types-among",
    "cost:exile-from-graveyard-card-types",
    "effect:targets-different-mana-values"
   ],
   "why": "zone-choice-together.ts already has 'variety' and 'distinct' rules; each card needs a definition field that reaches them (Winter, Nethergoyf's escape cost, Seasons Past). One wiring pass."
  },
  {
   "keys": [
    "decision:two-any-number-groups",
    "target:any-number-group-before-targeting-mode"
   ],
   "why": "An any-number target group that isn't the last slot of its list (Filigree Vector, Kamahl's Will)."
  },
  {
   "keys": [
    "decision:opponent-guesses-card-kind",
    "decision:opponent-guesses-mana-value"
   ],
   "why": "An opponent's binary guess about a hidden card, compared on reveal (Gollum, Master of Predicaments)."
  },
  {
   "keys": [
    "effect:each-opponent-exiles-card-from-hand-or-permanent",
    "effect:exile-per-life-lost-mixed-zones"
   ],
   "why": "One pick spanning permanents and cards in hand/graveyard (Nicol Bolas, Dragon-God; Lich's Mastery)."
  },
  {
   "keys": [
    "effect:emblem-own-activated-ability",
    "effect:emblem-activated-abilities"
   ],
   "why": "create-emblem with an activated ability of its own (Ob Nixilis of the Black Oath, Karn, Living Legacy)."
  },
  {
   "keys": [
    "effect:delayed-trigger-targets",
    "effect:delayed-trigger-dealt-damage-this-way-dies",
    "effect:delayed-return-from-graveyard-your-next-upkeep",
    "effect:delayed-trigger-watching-bolstered"
   ],
   "why": "delayed-trigger extensions: targets chosen as it fires, a watched this-way set, a from-graveyard return at your next upkeep, and a bolstered creature as the watched object."
  },
  {
   "keys": [
    "cost:sacrifice-up-to-n",
    "cost:sacrifice-x-of-token-stack",
    "cost:sacrifice-mana-value-x",
    "cost:graveyard-cast-sacrifice-count"
   ],
   "why": "The sacrifice cost's count and filter: up to N, X of them (and a token stack), mana value X, and two for a graveyard cast."
  },
  {
   "keys": [
    "condition:player-attacked-you-this-turn",
    "condition:attacked-player-this-turn-by-filter",
    "condition:attacking-player-left-an-opponent-unattacked",
    "stat:had-to-attack-condition"
   ],
   "why": "Reads of what was declared at attack declaration, kept in the journal (who attacked whom, with which creatures, under which requirements). Faramir's may already be covered by attacked-you-last-turn."
  },
  {
   "keys": [
    "effect:choose-party-sacrifice-rest",
    "effect:choose-per-player-destroy-rest"
   ],
   "why": "Each player chooses a set they keep and loses the rest (Stick Together, Unstable Glyphbridge)."
  },
  {
   "keys": [
    "zone:exile-library-bottom-face-down-cast-permanents",
    "zone:exile-from-library-bottom"
   ],
   "why": "Exiling from the bottom of a library (Arvinox, The Temporal Anchor): impulse-exile/exile-from-library taking the bottom."
  },
  {
   "keys": [
    "zone:impulse-free-lesser-mana-value-than-own",
