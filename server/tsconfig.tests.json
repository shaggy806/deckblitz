{
  // The server's tests, type-checked: vitest runs them without checking
  // types, so a wrong callback signature or a stale cast lets a test pass
  // without testing. Everything the build compiles plus every test file;
  // nothing is emitted. `npm run typecheck` runs it after the build check.
  // `manual-check-presets.test.ts` imports the client's preset list by its
  // `.ts` path, hence the extension import and the root above `src`.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "allowImportingTsExtensions": true, "rootDir": ".." },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
