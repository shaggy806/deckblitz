# dependencies
node_modules/

# build output
dist/
client/dist/
engine/dist/

# TypeScript incremental build info
*.tsbuildinfo
**/node_modules/.tmp/

# logs
npm-debug.log*
*.log

# editor / OS
.DS_Store
.vscode/
.idea/

# local scratch pads
scratch.*
scratch-*
*.scratch.*
.scratch/

# Claude Code agent worktrees (isolated checkouts for parallel card authoring)
.claude/worktrees/

# Long jobs' progress files (engine/scripts/progress.mjs), drawn by the job-progress Claude Code mod
.claude/progress/

# Playwright (client e2e)
client/test-results/
client/playwright-report/

# Played games' records (server/src/game-store.ts; `npm run games:pull` fetches the live site's here)
games/

# Scryfall bulk-data downloads (engine/scripts/gen-oracle.mjs)
engine/.cache/

# Positions captured from bot games (server --capture) — local training scenarios
captures/

# deploy.sh on the live box: its working folder, the replaced build kept for --rollback,
# and which commit is installed
.deploy-*
.deploy-prev/
.deploy-commit
__pycache__/

# who uses the site: the server's usage log (server/src/usage.ts)
usage/
